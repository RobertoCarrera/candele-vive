---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/decorative/Wave.astro';
---

<BaseLayout title="No encontrada" description="La página que buscas se ha apagado." noindex>
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">404</p>
      <h1 class="nf__title">Esta página se ha <em>apagado</em></h1>
      <Wave class="nf__wave" color="var(--terracotta)" />
      <p class="nf__body">
        La página que buscas no existe, o se la ha llevado el viento.
        Vuelve al inicio o pasa por el catálogo.
      </p>
      <div class="nf__ctas">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href="/catalogo" class="btn btn-ghost">Ir al catálogo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: var(--space-20);
  }
  .nf__inner { max-width: 36rem; }
  .nf__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .nf__title em { font-style: italic; color: var(--terracotta); }
  .nf__wave { width: 120px; height: 12px; margin: var(--space-4) auto; }
  .nf__body {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink-mute);
    margin-bottom: var(--space-8);
  }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
</style>
