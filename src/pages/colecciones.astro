---
/**
 * Página índice de Colecciones — optimizada para SEO + GEO.
 * - Intro largo sobre el sistema de colecciones estacionales
 * - Resumen estructurado de las 5 colecciones (ItemList schema)
 * - Datos clave: total velas, año fundación, formato, etc.
 * - FAQ global + People also ask
 * - Cross-link al catálogo completo
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/decorative/Wave.astro';
import { getCollection } from 'astro:content';
import { COLLECTIONS_CONTENT, type CollectionSlug } from '../data/collections-content';
import { collectionHero } from '../lib/images';
import { SITE } from '../data/site';

const collections = (await getCollection('collections'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const allProducts = await getCollection('products');
const totalProducts = allProducts.length;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Colecciones', item: SITE.url + '/colecciones' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Colecciones de velas Candele Vive',
    description:
      'Las cinco colecciones de velas aromáticas de Candele Vive: Ánima (primavera), Radice (invierno), Luce (otoño), Solea (verano) y Especiales. Cera de soja 100% natural, hechas a mano en Vilanova i la Geltrú.',
    url: SITE.url + '/colecciones',
    isPartOf: { '@id': SITE.url + '#website' },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: collections.length,
      itemListElement: collections.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: SITE.url + '/coleccion/' + c.data.slug,
        name: `Colección ${c.data.name} — ${c.data.season}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '¿Cuántas colecciones tiene Candele Vive?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Cinco colecciones: Ánima (primavera), Radice (invierno), Luce (otoño), Solea (verano) y Especiales (velas rituales, packs y ediciones limitadas).',
        },
      },
      {
        '@type': 'Question',
        name: '¿Las velas de Candele Vive son de cera de soja?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sí. Todas las velas de las cuatro colecciones estacionales son de cera de soja 100% natural de origen europeo, sin parafinas. La Colección Especiales incluye además velas de cera de abeja para rituales.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Cada cuánto se reformulan las colecciones?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Las cuatro colecciones estacionales se reformulan una vez al año, al inicio de cada temporada (marzo, junio, septiembre, diciembre). La Colección Especiales se actualiza con nuevas ediciones limitadas cuando surgen.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Puedo comprar una colección entera?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sí, todas las velas de cada colección están disponibles individualmente en la página de la colección. Si quieres las cinco velas de una colección, solo tienes que añadirlas una a una a la cesta. Hacemos descuentos por volumen a partir de 5 unidades.',
        },
      },
    ],
  },
];

const totalCandles = collections.reduce((s, c) => s + COLLECTIONS_CONTENT[c.data.slug as CollectionSlug].candleCount, 0);
const founded = 2024;
---

<BaseLayout
  title="Colecciones de velas aromáticas hechas a mano | Candele Vive"
  description="Las cinco colecciones de velas aromáticas de Candele Vive: Ánima, Radice, Luce, Solea y Especiales. Cera de soja 100% natural, hechas a mano en Vilanova i la Geltrú. {totalCandles} velas en total."
  jsonLd={jsonLd}
  bodyClass="page-collections"
>
  <header class="cls-hero">
    <div class="container">
      <p class="eyebrow cls-hero__eyebrow">catálogo · 5 colecciones · {totalProducts} velas</p>
      <h1 class="cls-hero__title">
        Las <em>colecciones</em>
      </h1>
      <Wave class="cls-hero__wave" color="var(--terracotta)" />
      <p class="cls-hero__lede">
        Cuatro familias estacionales — Ánima, Radice, Luce y Solea — más una
        colección sin calendario para velas rituales y ediciones limitadas.
        Todas hechas a mano con cera de soja 100% natural en Vilanova i la
        Geltrú (Barcelona), desde {founded}.
      </p>
    </div>
  </header>

  <section class="cls-stats">
    <div class="container">
      <ul class="cls-stats__grid">
        <li class="cls-stat">
          <span class="cls-stat__value">5</span>
          <span class="cls-stat__label">colecciones</span>
        </li>
        <li class="cls-stat">
          <span class="cls-stat__value">{totalProducts}</span>
          <span class="cls-stat__label">velas diferentes</span>
        </li>
        <li class="cls-stat">
          <span class="cls-stat__value">45 h</span>
          <span class="cls-stat__label">duración media por vela</span>
        </li>
        <li class="cls-stat">
          <span class="cls-stat__value">100%</span>
          <span class="cls-stat__label">cera de soja natural</span>
        </li>
        <li class="cls-stat">
          <span class="cls-stat__value">30-60</span>
          <span class="cls-stat__label">unidades por lote</span>
        </li>
        <li class="cls-stat">
          <span class="cls-stat__value">14 días</span>
          <span class="cls-stat__label">de reposo tras el vertido</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="cls-list">
    <div class="container-wide">
      <ul class="cls-list__grid">
        {collections.map((c) => {
          const cc = COLLECTIONS_CONTENT[c.data.slug as CollectionSlug];
          const product = allProducts
            .filter((p) => p.data.collection === c.data.slug)
            .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))[0];
          const heroImg = collectionHero(c.data.slug as CollectionSlug);
          return (
            <li class="cls-list__item">
              <a href={`/coleccion/${c.data.slug}`} class="cls-card">
                <div class="cls-card__media">
                  <img
                    src={heroImg}
                    alt={product ? product.data.imageAlt : `Colección ${c.data.name}`}
                    loading="lazy"
                  />
                </div>
                <div class="cls-card__body">
                  <div class="cls-card__meta">
                    <span class="cls-card__season">{c.data.season}</span>
                    <span class="cls-card__count">{cc.candleCount} velas</span>
                  </div>
                  <h2 class="cls-card__name">{c.data.name}</h2>
                  <p class="cls-card__tag">{c.data.heroTagline}</p>
                  <p class="cls-card__desc">{cc.introBody[0].split('. ')[0]}.</p>
                  <div class="cls-card__chips">
                    {cc.moods.map((m) => <span class="cls-card__chip">{m}</span>)}
                  </div>
                  <span class="cls-card__cta">ver {c.data.name} →</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="cls-help section">
    <div class="container cls-help__inner">
      <h2 class="cls-help__title">¿Cómo elijo?</h2>
      <p class="cls-help__lede">
        Si es la primera vez que pruebas Candele Vive, estas son las recomendaciones
        rápidas del taller. Si quieres algo más detallado, abre cada colección — la
        página tiene una guía completa de aromas, momentos y formatos.
      </p>
      <ul class="cls-help__grid">
        <li class="cls-help__item">
          <span class="cls-help__num">01</span>
          <h3>Para empezar</h3>
          <p>La <strong>Intuizione</strong> (jazmín) si te gustan aromas suaves, o la <strong>Focolare</strong> (leche caliente) si prefieres envolvente.</p>
        </li>
        <li class="cls-help__item">
          <span class="cls-help__num">02</span>
          <h3>Por temporada</h3>
          <p>Marzo-mayo: <strong>Ánima</strong>. Junio-agosto: <strong>Solea</strong>. Septiembre-noviembre: <strong>Luce</strong>. Diciembre-febrero: <strong>Radice</strong>.</p>
        </li>
        <li class="cls-help__item">
          <span class="cls-help__num">03</span>
          <h3>Para regalar</h3>
          <p>El <strong>Pack Miele</strong> (dos velas rituales) si quieres algo especial, o cualquier vela de <strong>Radice</strong> en caja kraft con sello.</p>
        </li>
        <li class="cls-help__item">
          <span class="cls-help__num">04</span>
          <h3>Con niños o mascotas</h3>
          <p>Los <strong>wax melts</strong> de la Colección Luce (Cuore, Nuvola) son sin llama — los más seguros para casa.</p>
        </li>
      </ul>
      <a href="/catalogo" class="btn btn-primary cls-help__cta">Ver las {totalProducts} velas del catálogo</a>
    </div>
  </section>

  <section class="cls-faq section">
    <div class="container cls-faq__inner">
      <header class="cls-faq__head">
        <p class="eyebrow">preguntas frecuentes</p>
        <h2 class="cls-faq__title">Sobre las colecciones</h2>
        <Wave class="cls-faq__wave" color="var(--terracotta)" />
      </header>
      <ul class="cls-faq__list" data-faq>
        {[
          { q: '¿Cuántas colecciones tiene Candele Vive?', a: 'Cinco: Ánima (primavera), Radice (invierno), Luce (otoño), Solea (verano) y Especiales (rituales, packs y ediciones limitadas).' },
          { q: '¿Las velas son de cera de soja?', a: 'Sí. Las cuatro colecciones estacionales son de cera de soja 100% natural europea. La Colección Especiales incluye además velas de cera de abeja para rituales.' },
          { q: '¿Cada cuánto se reformulan?', a: 'Una vez al año, al inicio de cada temporada (marzo, junio, septiembre, diciembre). Especiales se actualiza con ediciones limitadas según disponibilidad.' },
          { q: '¿Puedo comprar una colección entera?', a: 'Sí, todas las velas de cada colección están disponibles individualmente. Si quieres las cinco velas de una colección, las añades una a una a la cesta. Hacemos descuentos por volumen a partir de 5 unidades.' },
          { q: '¿Cuál es la colección más popular?', a: 'La vela más vendida de Candele Vive es la Risveglio (naranja con clavo), de la Colección Radice. En segundo lugar, Intuizione (jazmín) de Ánima.' },
        ].map((f) => (
          <li class="cls-faq__item">
            <details>
              <summary class="cls-faq__q">
                <span>{f.q}</span>
                <span class="cls-faq__icon" aria-hidden="true">+</span>
              </summary>
              <p class="cls-faq__a">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* === HERO === */
  .cls-hero { padding-block: var(--space-20) var(--space-12); text-align: center; }
  .cls-hero__eyebrow { color: var(--sage); }
  .cls-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .cls-hero__title em { font-style: italic; color: var(--terracotta); }
  .cls-hero__wave { width: 140px; height: 12px; margin: var(--space-4) auto; }
  .cls-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 40rem;
    margin-inline: auto;
  }

  /* === STATS === */
  .cls-stats { background: var(--bg-soft); padding-block: var(--space-12); }
  .cls-stats__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-8);
  }
  @media (min-width: 700px)  { .cls-stats__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .cls-stats__grid { grid-template-columns: repeat(6, 1fr); } }
  .cls-stat {
    text-align: center;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--bg-deep);
  }
  .cls-stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--terracotta);
    line-height: 1;
    font-weight: 500;
  }
  .cls-stat__label {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* === LIST === */
  .cls-list { background: var(--bg); padding-block: var(--space-20); }
  .cls-list__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 800px)  { .cls-list__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .cls-list__grid { grid-template-columns: repeat(3, 1fr); } }
  .cls-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }
  .cls-card__media {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    box-shadow: var(--sh-2);
    margin-bottom: var(--space-5);
  }
  .cls-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-soft); }
  .cls-card:hover .cls-card__media img { transform: scale(1.04); }
  .cls-card__body { flex: 1; display: flex; flex-direction: column; }
  .cls-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: var(--space-3);
  }
  .cls-card__count { color: var(--ink-mute); }
  .cls-card__name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1;
    margin-bottom: var(--space-2);
    transition: color 0.4s var(--ease-soft);
  }
  .cls-card:hover .cls-card__name { color: var(--terracotta); }
  .cls-card__tag {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--terracotta);
    font-size: 1rem;
    margin-bottom: var(--space-3);
  }
  .cls-card__desc {
    font-family: var(--font-display);
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: var(--space-4);
  }
  .cls-card__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--space-4); }
  .cls-card__chip {
    padding: 0.3rem 0.7rem;
    background: var(--bg-soft);
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-mute);
  }
  .cls-card__cta {
    margin-top: auto;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--terracotta);
  }

  /* === HELP === */
  .cls-help { background: var(--bg-soft); }
  .cls-help__inner { max-width: 64rem; }
  .cls-help__title {
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-style: italic;
    margin-bottom: var(--space-4);
  }
  .cls-help__lede {
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 40rem;
    margin: 0 auto var(--space-12);
  }
  .cls-help__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
  @media (min-width: 800px) { .cls-help__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .cls-help__grid { grid-template-columns: repeat(4, 1fr); } }
  .cls-help__item {
    background: var(--bg);
    border-radius: var(--r-lg);
    padding: var(--space-6);
  }
  .cls-help__num {
    font-family: var(--font-display);
    color: var(--terracotta);
    font-size: 0.9rem;
    display: block;
    margin-bottom: var(--space-3);
  }
  .cls-help__item h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
  .cls-help__item p {
    font-family: var(--font-display);
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .cls-help__item p strong { color: var(--ink); font-weight: 500; }
  .cls-help__cta { display: flex; justify-content: center; }

  /* === FAQ === */
  .cls-faq { background: var(--bg); }
  .cls-faq__inner { max-width: 48rem; }
  .cls-faq__head { text-align: center; margin-bottom: var(--space-12); }
  .cls-faq__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-top: var(--space-2);
  }
  .cls-faq__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .cls-faq__list { display: flex; flex-direction: column; gap: var(--space-2); }
  .cls-faq__item { background: var(--bg-soft); border-radius: var(--r-md); overflow: hidden; }
  .cls-faq__q {
    cursor: pointer;
    list-style: none;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .cls-faq__q::-webkit-details-marker { display: none; }
  .cls-faq__icon {
    color: var(--terracotta);
    font-size: 1.4rem;
    font-weight: 300;
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-soft);
  }
  details[open] .cls-faq__icon { transform: rotate(45deg); }
  .cls-faq__a {
    padding: 0 var(--space-6) var(--space-6);
    font-family: var(--font-display);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }
</style>
