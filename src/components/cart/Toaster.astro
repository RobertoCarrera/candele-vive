---
/**
 * Toaster — contenedor de notificaciones flotantes.
 * Escucha eventos `toast:show` en window. Se cierra solo a los `duration` ms.
 * Tipos: success, info, error.
 */
---

<div class="toaster" data-toaster aria-live="polite" aria-atomic="false"></div>

<style>
  .toaster {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 70;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    pointer-events: none;
  }
  @media (max-width: 600px) {
    .toaster { bottom: 90px; left: 16px; right: 16px; transform: none; }
  }

  :global(.toast) {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.85rem 1.1rem 0.85rem 0.85rem;
    background: var(--ink);
    color: var(--bg-soft);
    border-radius: var(--r-pill);
    box-shadow: var(--sh-3);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.2;
    max-width: 28rem;
    animation: toast-in 0.5s var(--ease) both;
  }
  :global(.toast--success) { background: var(--ink); }
  :global(.toast--info) { background: var(--ink); }
  :global(.toast--error) { background: var(--terracotta-deep); }
  :global(.toast.is-leaving) {
    animation: toast-out 0.4s var(--ease-soft) both;
  }
  :global(.toast__icon) {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--bg-soft);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  :global(.toast--error .toast__icon) { background: var(--bg-soft); color: var(--terracotta-deep); }
  :global(.toast__body) { display: flex; flex-direction: column; }
  :global(.toast__message) { line-height: 1.3; }
  :global(.toast__close) {
    background: transparent;
    border: 0;
    color: var(--bg-soft);
    opacity: 0.6;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0 4px;
    margin-left: 4px;
  }
  :global(.toast__close:hover) { opacity: 1; }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes toast-out {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(20px); }
  }
</style>

<script>
  const toaster = document.querySelector('[data-toaster]');
  if (toaster) {
    const ICONS = {
      success: '✓',
      info: 'i',
      error: '!',
    };

    function show(message, type = 'success', duration = 3000) {
      const el = document.createElement('div');
      el.className = `toast toast--${type}`;
      el.setAttribute('role', 'status');
      el.innerHTML = `
        <span class="toast__icon" aria-hidden="true">${ICONS[type] || '✓'}</span>
        <div class="toast__body">
          <span class="toast__message"></span>
        </div>
        <button class="toast__close" type="button" aria-label="Cerrar">×</button>
      `;
      el.querySelector('.toast__message').textContent = message;
      toaster.appendChild(el);

      const dismiss = () => {
        el.classList.add('is-leaving');
        el.addEventListener('animationend', () => el.remove(), { once: true });
      };
      el.querySelector('.toast__close')?.addEventListener('click', dismiss);
      setTimeout(dismiss, duration);
    }

    window.addEventListener('toast:show', (e) => {
      const d = e.detail || {};
      show(d.message || '', d.type || 'success', d.duration || 3000);
    });
  }
</script>
