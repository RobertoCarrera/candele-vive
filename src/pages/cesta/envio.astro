---
/**
 * Step 2: Datos de envío.
 * - Si la cesta está vacía, redirige a /cesta.
 * - Pre-rellena el formulario con el último envío guardado (si existe).
 * - Valida con `validateShipping` y muestra errores inline.
 * - Al enviar, guarda en `candele-checkout` y navega a /cesta/pago.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stepper from '../../components/checkout/Stepper.astro';
import Wave from '../../components/decorative/Wave.astro';
import { SPAIN_PROVINCES } from '../../data/spain';
---

<BaseLayout title="Datos de envío · Candele Vive" description="Cuéntanos dónde te enviamos las velas." bodyClass="page-checkout page-checkout--envio" noindex>
  <Stepper current={2} />

  <header class="env-hero">
    <div class="container">
      <p class="eyebrow">paso 2 de 4</p>
      <h1 class="env-hero__title">¿A dónde te <em>enviamos</em>?</h1>
      <Wave class="env-hero__wave" color="var(--terracotta)" />
      <p class="env-hero__lede">
        Necesitamos los datos de envío para preparar tu pedido. Los campos
        con asterisco son obligatorios.
      </p>
    </div>
  </header>

  <section class="env section">
    <div class="container env__inner">
      <form class="env-form" data-env-form novalidate>
        <fieldset class="env-form__group">
          <legend class="env-form__legend">Datos de contacto</legend>
          <div class="env-form__row">
            <label class="env-field">
              <span>Nombre completo *</span>
              <input type="text" name="name" required minlength="2" autocomplete="name" />
              <em class="env-field__error" data-error-for="name"></em>
            </label>
            <label class="env-field">
              <span>Email *</span>
              <input type="email" name="email" required autocomplete="email" />
              <em class="env-field__error" data-error-for="email"></em>
            </label>
          </div>
          <label class="env-field">
            <span>Teléfono *</span>
            <input type="tel" name="phone" required inputmode="numeric" pattern="[0-9 ]{9,}" placeholder="600 000 000" autocomplete="tel" />
            <em class="env-field__error" data-error-for="phone"></em>
          </label>
        </fieldset>

        <fieldset class="env-form__group">
          <legend class="env-form__legend">Dirección de envío</legend>
          <label class="env-field">
            <span>Calle y número *</span>
            <input type="text" name="address" required placeholder="C/ Mayor 12" autocomplete="address-line1" />
            <em class="env-field__error" data-error-for="address"></em>
          </label>
          <label class="env-field">
            <span>Piso, puerta, escalera (opcional)</span>
            <input type="text" name="address2" placeholder="3ºA" autocomplete="address-line2" />
          </label>
          <div class="env-form__row env-form__row--3">
            <label class="env-field">
              <span>Código postal *</span>
              <input type="text" name="postal" required inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="08800" autocomplete="postal-code" />
              <em class="env-field__error" data-error-for="postal"></em>
            </label>
            <label class="env-field">
              <span>Ciudad *</span>
              <input type="text" name="city" required autocomplete="address-level2" />
              <em class="env-field__error" data-error-for="city"></em>
            </label>
            <label class="env-field">
              <span>Provincia *</span>
              <select name="province" required autocomplete="address-level1">
                <option value="">Selecciona provincia…</option>
                {SPAIN_PROVINCES.map((p) => <option value={p}>{p}</option>)}
              </select>
              <em class="env-field__error" data-error-for="province"></em>
            </label>
          </div>
        </fieldset>

        <fieldset class="env-form__group">
          <legend class="env-form__legend">Notas (opcional)</legend>
          <label class="env-field">
            <span>¿Algo que debamos saber?</span>
            <textarea name="notes" rows="3" placeholder="Portero, horario preferido, mensaje para la persona que recibe…"></textarea>
          </label>
        </fieldset>

        <div class="env-form__cta">
          <a href="/cesta" class="btn btn-ghost">← Volver a la cesta</a>
          <button type="submit" class="btn btn-primary env-form__submit">
            Continuar al pago →
          </button>
        </div>
      </form>

      <aside class="env-help">
        <h2 class="env-help__title">Sobre el envío</h2>
        <Wave class="env-help__wave" color="var(--terracotta)" />
        <ul class="env-help__list">
          <li><span aria-hidden="true">✦</span> Envío gratis en pedidos superiores a 50€.</li>
          <li><span aria-hidden="true">✦</span> Entrega en 2-3 días hábiles en Península y Baleares.</li>
          <li><span aria-hidden="true">✦</span> Packaging reciclable, sin plásticos.</li>
          <li><span aria-hidden="true">✦</span> Si vives en Canarias, Ceuta o Melilla, escríbenos por WhatsApp antes de hacer el pedido.</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .env-hero { padding-block: var(--space-16) var(--space-8); text-align: center; }
  .env-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .env-hero__title em { font-style: italic; color: var(--terracotta); }
  .env-hero__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .env-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 36rem;
    margin: var(--space-4) auto 0;
  }

  .env { background: var(--bg); }
  .env__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    max-width: 64rem;
  }
  @media (min-width: 1000px) {
    .env__inner { grid-template-columns: 1.5fr 1fr; gap: var(--space-16); }
  }

  .env-form {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .env-form__group {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .env-form__legend {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding: 0;
    margin-bottom: var(--space-2);
  }
  .env-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 600px) {
    .env-form__row { grid-template-columns: 1fr 1fr; }
    .env-form__row--3 { grid-template-columns: 1fr 1.5fr 1.5fr; }
  }
  .env-field { display: flex; flex-direction: column; gap: 0; }
  .env-field > span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }
  .env-field input,
  .env-field select,
  .env-field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--bg-deep);
    border-radius: var(--r-md);
    padding: 0.85rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    transition: border-color 0.3s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .env-field select { appearance: none; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8' fill='none' stroke='%232D211B' stroke-width='1.5'><path d='M1 1l5 5 5-5'/></svg>"); background-repeat: no-repeat; background-position: right 1rem center; padding-right: 2.5rem; }
  .env-field input:focus,
  .env-field select:focus,
  .env-field textarea:focus {
    border-color: var(--terracotta);
    background: var(--bg-soft);
    outline: none;
  }
  .env-field.is-invalid input,
  .env-field.is-invalid select,
  .env-field.is-invalid textarea {
    border-color: var(--terracotta-deep);
  }
  .env-field__error {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--terracotta-deep);
    min-height: 1.2em;
    font-style: italic;
    margin-top: 4px;
  }

  .env-form__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--bg-deep);
  }
  .env-form__submit { font-size: 0.95rem; }

  .env-help {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    padding: var(--space-6);
    align-self: start;
    position: sticky;
    top: 90px;
  }
  .env-help__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--ink);
  }
  .env-help__wave { width: 50px; height: 10px; margin-block: var(--space-3) var(--space-4); }
  .env-help__list { display: flex; flex-direction: column; gap: var(--space-3); }
  .env-help__list li {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .env-help__list li span { color: var(--terracotta); flex-shrink: 0; }
</style>

<script>
  import { readCart, readCheckout, saveShipping, validateShipping } from '../../lib/checkout';

  const form = document.querySelector('[data-env-form]') as HTMLFormElement | null;
  if (form) {
    // Si la cesta está vacía, fuera
    const cart = readCart();
    if (!cart.items.length) {
      window.location.replace('/cesta');
    }

    // Pre-rellenar
    const existing = readCheckout();
    if (existing.shipping.name) {
      for (const k of ['name', 'email', 'phone', 'address', 'address2', 'postal', 'city', 'province', 'notes'] as const) {
        const input = form.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (input && existing.shipping[k]) input.value = existing.shipping[k];
      }
    }

    const setError = (field: string, msg: string) => {
      const err = form.querySelector(`[data-error-for="${field}"]`);
      const wrap = form.querySelector(`[name="${field}"]`)?.closest('.env-field');
      if (err) err.textContent = msg;
      if (wrap) wrap.classList.toggle('is-invalid', !!msg);
    };
    const clearErrors = () => {
      form.querySelectorAll('.env-field').forEach((el) => el.classList.remove('is-invalid'));
      form.querySelectorAll('.env-field__error').forEach((el) => el.textContent = '');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();
      const data = {
        name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
        email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
        phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim().replace(/\s/g, ''),
        address: (form.elements.namedItem('address') as HTMLInputElement).value.trim(),
        address2: (form.elements.namedItem('address2') as HTMLInputElement).value.trim(),
        postal: (form.elements.namedItem('postal') as HTMLInputElement).value.trim(),
        city: (form.elements.namedItem('city') as HTMLInputElement).value.trim(),
        province: (form.elements.namedItem('province') as HTMLSelectElement).value,
        country: 'España',
        notes: (form.elements.namedItem('notes') as HTMLTextAreaElement).value.trim(),
      };
      const result = validateShipping(data);
      if (!result.ok) {
        setError(result.field, result.message);
        // Scroll al primer error
        const el = form.querySelector(`[name="${result.field}"]`);
        el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      saveShipping(data);
      window.location.href = '/cesta/pago';
    });
  }
</script>
