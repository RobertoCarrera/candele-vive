---
/**
 * LegalPage — layout común para las páginas legales (aviso legal, privacidad,
 * cookies, envíos). Mantiene un estilo coherente con el resto de la web y
 * centraliza la fecha de "última actualización".
 *
 * Los textos son BASE LEGAL: deben ser revisados y validados por la gestoría
 * o el abogado del titular antes de publicar. Hay marcadores __NIF__,
 * __REGISTRO_MERCANTIL__, __EMAIL_DPD__ que el cliente debe rellenar.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

interface Props {
  title: string;
  description: string;
  lastUpdated: string; // formato "agosto 2026"
  effectiveDate: string; // formato "20 de agosto de 2026"
}

const { title, description, lastUpdated, effectiveDate } = Astro.props;
---

<BaseLayout title={`${title} | ${SITE.name}`} description={description} noindex={true}>
  <header class="legal-hero">
    <div class="container legal-hero__inner">
      <p class="eyebrow">Información legal</p>
      <h1 class="legal-hero__title">{title}</h1>
      <p class="legal-hero__meta">
        Última actualización: <strong>{lastUpdated}</strong> · En vigor desde el {effectiveDate}
      </p>
    </div>
  </header>

  <section class="legal-body section">
    <div class="container legal-body__inner">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    padding-block: var(--space-16) var(--space-8);
    background: var(--bg);
    text-align: center;
    border-bottom: 1px solid var(--bg-deep);
  }
  .legal-hero__inner { max-width: 44rem; margin-inline: auto; }
  .legal-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.1;
    color: var(--ink);
    margin-top: var(--space-3);
  }
  .legal-hero__meta {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-mute);
    margin-top: var(--space-4);
  }
  .legal-hero__meta strong {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .legal-body { background: var(--bg); }
  .legal-body__inner {
    max-width: 44rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .legal-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(p) {
    margin-bottom: var(--space-4);
  }
  .legal-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .legal-body :global(li) {
    margin-bottom: var(--space-2);
  }
  .legal-body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .legal-body :global(a) {
    color: var(--terracotta);
    border-bottom: 1px solid var(--terracotta-soft);
    transition: border-color 0.3s var(--ease-soft);
  }
  .legal-body :global(a:hover) {
    border-bottom-color: var(--terracotta);
  }
  .legal-body :global(.legal-callout) {
    background: var(--bg-soft);
    border-left: 2px solid var(--terracotta);
    padding: var(--space-4) var(--space-6);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    margin: var(--space-6) 0;
    font-style: italic;
  }
  .legal-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
  }
  .legal-body :global(th),
  .legal-body :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--bg-deep);
  }
  .legal-body :global(th) {
    background: var(--bg-soft);
    font-weight: 600;
    color: var(--ink);
  }
</style>
