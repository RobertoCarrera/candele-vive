---
/**
 * Step 3: Método de pago.
 * - Si la cesta está vacía → /cesta.
 * - Si no hay envío guardado → /cesta/envio.
 * - El usuario elige método (WhatsApp por defecto).
 * - "Finalizar pedido" genera el mensaje de WhatsApp, lo abre en otra pestaña,
 *   guarda el pedido en `candele-last-order`, vacía cesta + checkout,
 *   y navega a /cesta/confirmacion.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stepper from '../../components/checkout/Stepper.astro';
import Wave from '../../components/decorative/Wave.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';

const allProducts = await getCollection('products');
const productsData = allProducts.map((p) => ({
  id: p.data.id,
  name: p.data.name,
  price: p.data.price,
  category: p.data.category,
  collection: p.data.collection,
}));
---

<BaseLayout title="Método de pago · Candele Vive" description="Elige cómo quieres cerrar el pedido." bodyClass="page-checkout page-checkout--pago" noindex>
  <Stepper current={3} />

  <header class="pay-hero">
    <div class="container">
      <p class="eyebrow">paso 3 de 4</p>
      <h1 class="pay-hero__title">¿Cómo <em>quieres pagar</em>?</h1>
      <Wave class="pay-hero__wave" color="var(--terracotta)" />
      <p class="pay-hero__lede">
        Por ahora cerramos los pedidos por WhatsApp. Estamos preparando el pago
        con tarjeta para las próximas semanas.
      </p>
    </div>
  </header>

  <section class="pay section">
    <div class="container pay__inner">
      <div class="pay__methods">
        <h2 class="pay__title">Métodos disponibles</h2>
        <ul class="pay__list" data-pay-list>
          <li class="pay-method pay-method--active" data-method="whatsapp">
            <input type="radio" name="method" value="whatsapp" id="m-whatsapp" checked />
            <label for="m-whatsapp">
              <div class="pay-method__head">
                <span class="pay-method__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M16 3C8.82 3 3 8.82 3 16c0 2.4.66 4.66 1.81 6.6L3 29l6.6-1.73A12.96 12.96 0 0 0 16 29c7.18 0 13-5.82 13-13S23.18 3 16 3zm7.36 18.46c-.31.86-1.78 1.62-2.5 1.71-.64.08-1.45.12-2.34-.15-.54-.16-1.23-.39-2.12-.78-3.74-1.62-6.17-5.4-6.36-5.65-.19-.25-1.5-2-1.5-3.81s.95-2.7 1.29-3.07c.34-.36.74-.46.99-.46s.49 0 .71.01c.23.01.54-.09.84.64.31.74 1.05 2.55 1.14 2.74.09.19.15.4.03.65-.12.25-.19.4-.37.62-.19.22-.39.49-.56.66-.19.19-.38.39-.16.76.22.37.97 1.6 2.08 2.59 1.43 1.27 2.63 1.67 3 1.86.37.19.59.16.8-.1.22-.25.92-1.07 1.16-1.44.25-.37.49-.31.83-.19.34.12 2.18 1.03 2.55 1.22.37.19.62.28.71.43.09.16.09.92-.22 1.78z"/></svg>
                </span>
                <div>
                  <h3 class="pay-method__name">Cerrar por WhatsApp</h3>
                  <p class="pay-method__sub">Te enviamos un mensaje con el detalle, confirmas y preparamos el envío. Recomendado.</p>
                </div>
                <span class="pay-method__check" aria-hidden="true">✓</span>
              </div>
            </label>
          </li>

          <li class="pay-method pay-method--active" data-method="pickup">
            <input type="radio" name="method" value="pickup" id="m-pickup" />
            <label for="m-pickup">
              <div class="pay-method__head">
                <span class="pay-method__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6v11a2 2 0 0 1-2 2h-4v-7h-6v7H5a2 2 0 0 1-2-2z"/></svg>
                </span>
                <div>
                  <h3 class="pay-method__name">Recogida en taller</h3>
                  <p class="pay-method__sub">Pasa por el estudio de Vilanova i la Geltrú (cita previa). Sin gastos de envío.</p>
                </div>
                <span class="pay-method__check" aria-hidden="true">✓</span>
              </div>
            </label>
          </li>

          <li class="pay-method pay-method--disabled" aria-disabled="true">
            <input type="radio" name="method" value="card" id="m-card" disabled />
            <label for="m-card">
              <div class="pay-method__head">
                <span class="pay-method__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                </span>
                <div>
                  <h3 class="pay-method__name">Tarjeta de crédito <span class="pay-method__tag">Próximamente</span></h3>
                  <p class="pay-method__sub">Stripe. Pago seguro, encriptado, sin guardar datos.</p>
                </div>
                <span class="pay-method__check" aria-hidden="true">✕</span>
              </div>
            </label>
          </li>
        </ul>

        <div class="pay__cta">
          <a href="/cesta/envio" class="btn btn-ghost">← Volver a envío</a>
          <button type="button" class="btn btn-primary pay__submit" data-pay-submit>
            Finalizar pedido →
          </button>
        </div>

        <p class="pay__note">
          Al hacer clic en "Finalizar pedido" se abrirá WhatsApp con el detalle
          del pedido. Te responderemos en menos de 24h para confirmar el envío.
        </p>
      </div>

      <aside class="pay-summary">
        <h2 class="pay-summary__title">Resumen del pedido</h2>
        <Wave class="pay-summary__wave" color="var(--terracotta)" />
        <ul class="pay-summary__items" data-pay-items></ul>
        <div class="pay-summary__rows">
          <div class="pay-summary__row">
            <span>Subtotal</span>
            <strong data-pay-subtotal>0,00 €</strong>
          </div>
          <div class="pay-summary__row">
            <span>Envío</span>
            <strong data-pay-shipping>—</strong>
          </div>
          <div class="pay-summary__row pay-summary__row--total">
            <span>Total</span>
            <strong data-pay-total>0,00 €</strong>
          </div>
        </div>
        <p class="pay-summary__ship" data-pay-ship></p>
      </aside>
    </div>
  </section>
</BaseLayout>

<!-- Datos que el JS del cliente necesita (productos + constantes) -->
<script id="pay-data" type="application/json" set:html={JSON.stringify({
  products: productsData,
  freeShippingThreshold: SITE.freeShippingThreshold,
  shippingCost: SITE.shippingCost,
})} />

<style>
  .pay-hero { padding-block: var(--space-16) var(--space-8); text-align: center; }
  .pay-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .pay-hero__title em { font-style: italic; color: var(--terracotta); }
  .pay-hero__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .pay-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 36rem;
    margin: var(--space-4) auto 0;
  }

  .pay { background: var(--bg); }
  .pay__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    max-width: 64rem;
  }
  @media (min-width: 1000px) {
    .pay__inner { grid-template-columns: 1.4fr 1fr; gap: var(--space-16); }
  }

  .pay__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }
  .pay__list { display: flex; flex-direction: column; gap: var(--space-3); }

  .pay-method {
    position: relative;
    border: 1.5px solid var(--bg-deep);
    border-radius: var(--r-lg);
    background: var(--bg-soft);
    transition: all 0.3s var(--ease-soft);
  }
  .pay-method input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pay-method label {
    display: block;
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
  }
  .pay-method__head {
    display: grid;
    grid-template-columns: 40px 1fr 24px;
    align-items: center;
    gap: var(--space-4);
  }
  .pay-method__icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--bg-deep);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pay-method__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pay-method__tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-mute);
    background: var(--bg);
    border: 1px solid var(--bg-deep);
    padding: 0.2rem 0.5rem;
    border-radius: var(--r-pill);
  }
  .pay-method__sub {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-mute);
    margin-top: 2px;
  }
  .pay-method__check {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--bg-deep);
  }
  .pay-method--active:hover { border-color: var(--terracotta); }
  .pay-method--active:has(input:checked) {
    border-color: var(--ink);
    background: var(--cream, #FAF6EC);
    box-shadow: 0 0 0 1px var(--ink);
  }
  .pay-method--active:has(input:checked) .pay-method__icon {
    background: var(--terracotta);
    color: var(--bg-soft);
    border-color: var(--terracotta);
  }
  .pay-method--active:has(input:checked) .pay-method__check {
    color: var(--terracotta);
  }
  .pay-method--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .pay-method--disabled label { cursor: not-allowed; }
  .pay-method--disabled .pay-method__check { color: var(--terracotta); }

  .pay__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    margin-top: var(--space-6);
  }
  .pay__submit { font-size: 0.95rem; }
  .pay__note {
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-mute);
    font-style: italic;
    line-height: 1.5;
  }

  .pay-summary {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    padding: var(--space-6);
    align-self: start;
    position: sticky;
    top: 90px;
  }
  .pay-summary__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    color: var(--ink);
  }
  .pay-summary__wave { width: 50px; height: 10px; margin-block: var(--space-3) var(--space-4); }
  .pay-summary__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--bg-deep);
  }
  .pay-summary__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-soft);
    gap: var(--space-2);
  }
  .pay-summary__item strong { color: var(--ink); font-weight: 500; }
  .pay-summary__item em { font-style: normal; color: var(--ink-mute); }
  .pay-summary__item-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pay-summary__rows { display: flex; flex-direction: column; gap: 0.3rem; }
  .pay-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .pay-summary__row strong { font-family: var(--font-display); font-size: 1.1rem; color: var(--ink); font-weight: 500; }
  .pay-summary__row--total {
    border-top: 1px solid var(--bg-deep);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
  }
  .pay-summary__row--total strong { font-size: 1.5rem; }
  .pay-summary__ship {
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-mute);
    font-style: italic;
    line-height: 1.5;
  }
  .pay-summary__ship strong { color: var(--ink); font-style: normal; }
</style>

<script>
  import { readCart, readCheckout, saveMethod, buildWhatsAppMessage, generateOrderNumber, saveLastOrder, clearCart, clearCheckout, whatsappOrderLink, formatPrice, type PaymentMethod } from '../../lib/checkout';

  // Guardas
  const cart = readCart();
  const checkout = readCheckout();
  if (!cart.items.length) {
    window.location.replace('/cesta');
  } else if (!checkout.shipping.name) {
    window.location.replace('/cesta/envio');
  }

  // Cargar datos inyectados
  type ProductMap = { id: number; name: string; price: number; category: string; collection: string };
  type PayData = { products: ProductMap[]; freeShippingThreshold: number; shippingCost: number };
  const data: PayData = JSON.parse(document.getElementById('pay-data')?.textContent || '{"products":[],"freeShippingThreshold":50,"shippingCost":6.95}');
  const PRODUCT_BY_ID: Record<number, ProductMap> = Object.fromEntries(data.products.map((p) => [p.id, p]));
  const { freeShippingThreshold, shippingCost } = data;

  // Pre-seleccionar método guardado
  if (checkout.method) {
    const radio = document.querySelector<HTMLInputElement>(`input[value="${checkout.method}"]`);
    if (radio) radio.checked = true;
  }

  // Resumen
  const itemsEl = document.querySelector('[data-pay-items]');
  if (itemsEl) {
    itemsEl.innerHTML = cart.items.map((it) => {
      const p = PRODUCT_BY_ID[it.id];
      if (!p) return '';
      return `
        <li class="pay-summary__item">
          <span class="pay-summary__item-name">${p.name} <em>× ${it.qty}</em></span>
          <strong>${formatPrice(p.price * it.qty)}</strong>
        </li>
      `;
    }).join('');
  }

  const renderTotals = () => {
    const subtotal = cart.items.reduce((s, it) => {
      const p = PRODUCT_BY_ID[it.id];
      return p ? s + p.price * it.qty : s;
    }, 0);
    const isPickup = (document.querySelector<HTMLInputElement>('input[name="method"]:checked')?.value) === 'pickup';
    const ship = isPickup ? 0 : (subtotal >= freeShippingThreshold ? 0 : shippingCost);
    const total = subtotal + ship;
    const setText = (sel: string, v: string) => { const el = document.querySelector(sel); if (el) el.textContent = v; };
    setText('[data-pay-subtotal]', formatPrice(subtotal));
    setText('[data-pay-shipping]', ship === 0 ? 'Gratis ✦' : formatPrice(ship));
    setText('[data-pay-total]', formatPrice(total));
  };
  renderTotals();

  // Detalle de envío
  const shipText = document.querySelector('[data-pay-ship]');
  if (shipText) {
    const s = checkout.shipping;
    shipText.innerHTML = `Enviar a: <strong>${s.name}</strong><br />${s.address}${s.address2 ? ', ' + s.address2 : ''}<br />${s.postal} ${s.city}, ${s.province}`;
  }

  // Cambio de método → recalcular envío
  document.querySelectorAll<HTMLInputElement>('input[name="method"]').forEach((r) => {
    r.addEventListener('change', () => {
      const v = r.value;
      if (v === 'whatsapp' || v === 'pickup') {
        saveMethod(v);
        renderTotals();
      }
    });
  });

  // Finalizar pedido
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-pay-submit]');
  submitBtn?.addEventListener('click', () => {
    const methodInput = document.querySelector<HTMLInputElement>('input[name="method"]:checked');
    if (!methodInput) {
      window.dispatchEvent(new CustomEvent('toast:show', {
        detail: { message: 'Elige un método de pago', type: 'error' },
      }));
      return;
    }
    const method = methodInput.value as PaymentMethod;
    saveMethod(method);

    const subtotal = cart.items.reduce((s, it) => {
      const p = PRODUCT_BY_ID[it.id];
      return p ? s + p.price * it.qty : s;
    }, 0);
    const isPickup = method === 'pickup';
    const ship = isPickup ? 0 : (subtotal >= freeShippingThreshold ? 0 : shippingCost);

    const orderNumber = generateOrderNumber();
    const items = cart.items.map((it) => {
      const p = PRODUCT_BY_ID[it.id];
      return { id: it.id, name: p?.name || `Vela ${it.id}`, price: p?.price || 0, qty: it.qty, category: p?.category || '' };
    });

    const message = buildWhatsAppMessage({
      orderNumber,
      shipping: checkout.shipping,
      method,
      items,
      subtotal,
      shippingCost: ship,
      discount: 0,
    });
    const url = whatsappOrderLink(message);

    saveLastOrder({
      number: orderNumber,
      when: new Date().toISOString(),
      items,
      shipping: checkout.shipping,
      method,
      subtotal,
      shippingCost: ship,
      discount: 0,
      total: subtotal + ship,
    });

    window.open(url, '_blank');
    clearCart();
    clearCheckout();
    window.location.href = '/cesta/confirmacion';
  });
</script>
