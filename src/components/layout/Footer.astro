---
/**
 * Footer — limpio, sin ornamento. Cuatro columnas, una ola separadora.
 */
import Wave from '../decorative/Wave.astro';
import { SITE, whatsappLink } from '../../data/site';
import { UI } from '../../data/ui';

const year = new Date().getFullYear();
const collectionLinks = [
  { slug: 'anima', label: 'Ánima · Primavera' },
  { slug: 'radice', label: 'Radice · Invierno' },
  { slug: 'luce', label: 'Luce · Otoño' },
  { slug: 'solea', label: 'Solea · Verano' },
  { slug: 'especiales', label: 'Especiales' },
];
const studioLinks = [
  { href: '/taller', label: 'El taller' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/cesta', label: 'Mi cesta' },
];
---

<footer class="ft">
  <div class="container-wide">
    <div class="ft__top" aria-hidden="true">
      <Wave class="ft__wave" color="var(--terracotta)" />
    </div>

    <div class="ft__grid">
      <section class="ft__col ft__col--brand">
        <p class="ft__brand">Candele<span class="ft__brand-dot">·</span><em>vive</em></p>
        <p class="ft__copy">{UI.footer.tagline}</p>
        <p class="ft__motto">
          <span class="ft__motto-mark" aria-hidden="true">“</span>
          Una vela nunca perderá nada por ayudar a encender otra.
        </p>
        <div class="ft__contact">
          <p>{SITE.address.locality} · {SITE.address.region}</p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p>
            <a href={whatsappLink('Hola, me gustaría información sobre una vela')}>WhatsApp</a>
          </p>
        </div>
      </section>

      <section class="ft__col">
        <h3 class="ft__title">{UI.footer.collectionsTitle}</h3>
        <ul class="ft__list">
          {collectionLinks.map((c) => (
            <li>
              <a href={`/coleccion/${c.slug}`} class="ft__link">{c.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="ft__col">
        <h3 class="ft__title">{UI.footer.companyTitle}</h3>
        <ul class="ft__list">
          {studioLinks.map((l) => (
            <li>
              <a href={l.href} class="ft__link">{l.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="ft__col ft__col--news">
        <h3 class="ft__title">{UI.footer.newsletterTitle}</h3>
        <p class="ft__news-copy">{UI.footer.newsletterCopy}</p>
        <a
          class="btn btn-primary ft__whatsapp-cta"
          href={whatsappLink('Hola, me gustaría apuntarme a la carta mensual de Candele Vive ✦')}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12c0 1.94.55 3.74 1.49 5.27L2 22l4.84-1.46A9.96 9.96 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.6 14.2c-.24.66-1.38 1.27-1.94 1.34-.5.07-1.13.1-1.83-.12-.42-.13-.96-.31-1.66-.61-2.93-1.27-4.84-4.24-4.99-4.44-.15-.2-1.18-1.57-1.18-2.99s.75-2.12 1.01-2.41c.26-.29.57-.36.77-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 1.01 2.16.07.14.13.31.02.5-.1.2-.15.31-.29.49-.15.18-.31.39-.45.52-.15.15-.31.31-.13.6.18.29.77 1.27 1.66 2.06 1.13 1 2.09 1.32 2.37 1.47.29.15.46.13.63-.07.18-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2.01.96.29.15.49.22.56.34.07.12.07.71-.17 1.39z"/>
          </svg>
          Únete por WhatsApp
        </a>
        <p class="ft__news-alt">
          o escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </section>
    </div>

    <a
      class="ft__creator"
      href="https://sincronia.agency/contacto/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="ft__creator-text">
        Somos los <em>creadores</em> de esta web.
        <em>¿La quieres para ti?</em>
      </span>
      <span class="ft__creator-arrow" aria-hidden="true">→</span>
    </a>

    <div class="ft__base">
      <p class="ft__copy-mini">{UI.footer.copyright(year)}</p>
      <div class="ft__base-right">
        <button
          type="button"
          class="ft__legal-link ft__cookies-btn"
          data-cookie-open
        >
          Configurar cookies
        </button>
        <ul class="ft__legal">
          {UI.footer.legal.map((label) => (
            <li><a href={`/${label.toLowerCase().replace(/ /g, '-').normalize('NFD').replace(/[\u0300-\u036f]/g, '')}`} class="ft__legal-link">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--bg-warm);
    padding-block: var(--space-20) var(--space-8);
    margin-top: var(--space-24);
  }
  .ft__top { display: flex; justify-content: center; margin-bottom: var(--space-12); }
  .ft__wave { width: 200px; height: 12px; }

  .ft__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
  }
  @media (min-width: 700px)  { .ft__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .ft__grid { grid-template-columns: 1.4fr 1fr 1fr 1.4fr; gap: var(--space-16); } }

  .ft__brand {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--ink);
    margin-bottom: var(--space-4);
    font-weight: 500;
  }
  .ft__brand em { font-style: italic; color: var(--terracotta); font-weight: 400; }
  .ft__brand-dot { color: var(--terracotta); margin: 0 0.05em; }

  .ft__copy {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 32rem;
    font-style: italic;
  }
  .ft__motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-top: var(--space-3);
    padding-left: var(--space-4);
    border-left: 2px solid var(--terracotta);
    max-width: 24rem;
  }
  .ft__motto-mark {
    color: var(--terracotta);
    font-size: 1.3em;
    line-height: 0;
    margin-right: 0.1em;
  }
  .ft__contact {
    margin-top: var(--space-4);
    font-size: 0.85rem;
    color: var(--ink-mute);
    line-height: 1.7;
  }
  .ft__contact a:hover { color: var(--terracotta); }

  .ft__title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: var(--space-4);
  }
  .ft__list li { margin-bottom: 0.6rem; }
  .ft__link {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--ink);
    transition: color 0.3s var(--ease-soft);
  }
  .ft__link:hover { color: var(--terracotta); }

  .ft__news-copy {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .ft__whatsapp-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ft__news-alt {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-mute);
    margin-top: var(--space-3);
    font-style: normal;
  }
  .ft__news-alt a {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--bg-deep);
  }
  .ft__news-alt a:hover {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }

  .ft__base {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    text-align: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--bg-deep);
  }
  @media (min-width: 700px) {
    .ft__base {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .ft__copy-mini {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }

  .ft__creator {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block: var(--space-10) var(--space-8);
    margin-inline: auto;
    max-width: 36rem;
    width: fit-content;
    max-width: min(36rem, 100%);
    padding: 0.9rem 1.4rem;
    background: var(--ink);
    color: var(--bg-soft);
    border-radius: var(--r-pill);
    text-decoration: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    line-height: 1.35;
    transition: background 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .ft__creator:hover {
    background: var(--terracotta);
    color: var(--bg-soft);
    transform: translateY(-1px);
  }
  .ft__creator:focus-visible {
    outline: 2px solid var(--terracotta-soft);
    outline-offset: 3px;
  }
  .ft__creator em {
    font-style: italic;
    color: var(--terracotta-soft);
    border-bottom: 1.5px solid var(--terracotta-soft);
    padding-bottom: 1px;
    transition: color 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft);
  }
  .ft__creator:hover em {
    color: var(--bg-soft);
    border-bottom-color: var(--bg-soft);
  }
  .ft__creator-arrow {
    flex-shrink: 0;
    font-style: normal;
    font-family: var(--font-body);
    font-size: 1.3rem;
    transition: transform 0.3s var(--ease-soft);
  }
  .ft__creator:hover .ft__creator-arrow {
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .ft__creator {
      padding: 1rem 1.2rem;
      font-size: 0.95rem;
    }
    .ft__creator-arrow { font-size: 1.1rem; }
  }
  .ft__base-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  @media (min-width: 700px) {
    .ft__base-right { justify-content: flex-end; }
  }
  .ft__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }
  .ft__cookies-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .ft__legal-link {
    font-size: 0.72rem;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
  }
  .ft__legal-link:hover { color: var(--terracotta); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Re-abrir el banner de cookies desde el footer.
  const cookieBtn = document.querySelector('[data-cookie-open]');
  cookieBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cookie:open'));
  });
</script>
