---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import Wave from '../components/decorative/Wave.astro';
import Stepper from '../components/checkout/Stepper.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { UI } from '../data/ui';

const allProducts = await getCollection('products');
const featured = allProducts
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3);

const products = allProducts.map((p) => ({
  id: p.data.id,
  name: p.data.name,
  price: p.data.price,
  category: p.data.category,
  collection: p.data.collection,
  image: p.data.image,
  imageAlt: p.data.imageAlt,
}));
---

<BaseLayout title="Tu cesta" description="Revisa las velas que llevas y continúa con el envío." bodyClass="page-cart" noindex>
  <Stepper current={1} />

  <header class="cart-hero">
    <div class="container">
      <p class="eyebrow">{UI.cart.tagline}</p>
      <h1 class="cart-hero__title">Tu <em>cesta</em></h1>
      <Wave class="cart-hero__wave" color="var(--terracotta)" />
      <p class="cart-hero__lede">
        Revisa lo que llevas, ajusta las cantidades, aplica el cupón si tienes uno,
        y cuando estés listo, te pedimos los datos de envío.
      </p>
    </div>
  </header>

  <section class="cart section">
    <div class="container cart__inner">
      <div class="cart__items" data-cart-items>
        <div class="cart__empty" data-cart-empty>
          <p class="cart__empty-title">{UI.cart.empty}</p>
          <p class="cart__empty-body">{UI.cart.emptyBody}</p>
          <a href="/catalogo" class="btn btn-primary">Ir al catálogo</a>
        </div>
        <ul class="cart__list" data-cart-list hidden></ul>
      </div>

      <aside class="cart__summary" data-cart-summary hidden>
        <h2 class="cart__summary-title">{UI.cart.summaryTitle}</h2>
        <Wave class="cart__summary-wave" color="var(--terracotta)" />

        <div class="cart__row">
          <span>{UI.cart.subtotal}</span>
          <strong data-cart-subtotal>0,00 €</strong>
        </div>
        <div class="cart__row">
          <span>{UI.cart.shipping}</span>
          <strong data-cart-shipping>6,95 €</strong>
        </div>

        <p class="cart__progress" data-cart-progress hidden></p>

        <div class="cart__promo">
          <label class="cart__promo-label" for="promo">{UI.cart.promo}</label>
          <div class="cart__promo-row">
            <input id="promo" type="text" placeholder={UI.cart.promoPlaceholder} autocomplete="off" data-promo-input />
            <button class="btn btn-ghost cart__promo-btn" data-promo-apply>{UI.buttons.applyPromo}</button>
          </div>
          <p class="cart__promo-status" data-promo-status></p>
        </div>

        <div class="cart__row cart__row--total">
          <span>{UI.cart.total}</span>
          <strong data-cart-total>0,00 €</strong>
        </div>

        <a href="/cesta/envio" class="btn btn-primary cart__continue-checkout" data-cart-checkout>
          Continuar al envío →
        </a>
        <a href="/catalogo" class="cart__continue">{UI.buttons.continueShopping}</a>

        <ul class="cart__trust">
          {UI.cart.trustBadges.map((b) => <li><span aria-hidden="true">✦</span> {b}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="cart-recs section">
      <div class="container-wide">
        <header class="cart-recs__head">
          <p class="eyebrow">{UI.cart.recommendationsTagline}</p>
          <h2 class="cart-recs__title">{UI.cart.recommendationsTitle}</h2>
          <Wave class="cart-recs__wave" color="var(--terracotta)" />
        </header>
        <ul class="cart-recs__grid">
          {featured.map((p) => (
            <li>
              <ProductCard
                id={p.data.id}
                name={p.data.name}
                price={p.data.price}
                category={p.data.category}
                collection={p.data.collection}
                image={p.data.image}
                imageAlt={p.data.imageAlt}
                burnTime={p.data.burnTime}
                size={p.data.size}
                badge={p.data.badge}
                shortDescription={p.data.shortDescription}
                order={p.data.order}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .cart-hero { padding-block: var(--space-16) var(--space-8); text-align: center; }
  .cart-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .cart-hero__title em { font-style: italic; color: var(--terracotta); }
  .cart-hero__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .cart-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38rem;
    margin: var(--space-4) auto 0;
  }

  .cart { background: var(--bg); }
  .cart__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 1000px) { .cart__inner { grid-template-columns: 1.5fr 1fr; gap: var(--space-16); } }

  .cart__empty {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--bg-soft);
    border-radius: var(--r-lg);
  }
  .cart__empty-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
    font-style: italic;
    margin-bottom: var(--space-3);
  }
  .cart__empty-body {
    font-family: var(--font-display);
    color: var(--ink-mute);
    font-size: 1.05rem;
    margin-bottom: var(--space-6);
    max-width: 32rem;
    margin-inline: auto;
  }

  .cart__summary {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    padding: var(--space-6);
    align-self: start;
    position: sticky;
    top: 90px;
  }
  .cart__summary-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
  }
  .cart__summary-wave { width: 60px; height: 12px; margin-block: var(--space-3) var(--space-4); }
  .cart__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .cart__row strong { font-family: var(--font-display); font-size: 1.1rem; color: var(--ink); font-weight: 500; }
  .cart__row--total {
    border-top: 1px solid var(--bg-deep);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
  }
  .cart__row--total strong { font-size: 1.6rem; }

  .cart__progress {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--terracotta);
  }

  .cart__promo { margin-top: var(--space-4); }
  .cart__promo-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: var(--space-2);
  }
  .cart__promo-row { display: flex; gap: var(--space-2); }
  .cart__promo-row input { background: var(--bg); border: 1px solid var(--bg-deep); border-radius: var(--r-md); padding: 0.6rem 0.8rem; }
  .cart__promo-btn { padding: 0.6rem 1rem; }
  .cart__promo-status {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--sage);
    min-height: 1.2em;
  }
  .cart__promo-status.is-error { color: var(--terracotta); }

  .cart__continue-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-6);
    font-size: 0.95rem;
  }
  .cart__continue-checkout[aria-disabled="true"],
  .cart__continue-checkout.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .cart__continue {
    display: block;
    text-align: center;
    margin-top: var(--space-3);
    font-family: var(--font-hand);
    font-size: 1.1rem;
    color: var(--ink-mute);
  }
  .cart__continue:hover { color: var(--terracotta); }

  .cart__trust {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--bg-deep);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cart__trust li {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-mute);
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .cart__trust li span { color: var(--terracotta); }

  .cart-recs { background: var(--bg-soft); }
  .cart-recs__head { text-align: center; margin-bottom: var(--space-12); }
  .cart-recs__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: var(--space-2);
  }
  .cart-recs__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .cart-recs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 700px)  { .cart-recs__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .cart-recs__grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<style is:global>
  /* === Items de la cesta (renderizados por JS, sin scope de Astro) === */
  .cart-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    column-gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--bg-soft);
    border-radius: var(--r-lg);
  }
  @media (min-width: 700px) {
    .cart-item { grid-template-columns: 120px 1fr auto; padding: var(--space-5) var(--space-6); }
  }
  .cart-item__media {
    width: 90px;
    height: 90px;
    background: var(--bg-warm);
    border-radius: var(--r-md);
    overflow: hidden;
    display: block;
  }
  @media (min-width: 700px) {
    .cart-item__media { width: 120px; height: 120px; }
  }
  .cart-item__media img { width: 100%; height: 100%; object-fit: cover; }
  .cart-item__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cart-item__cat {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .cart-item__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
    line-height: 1.2;
    text-decoration: none;
  }
  .cart-item__name:hover { color: var(--terracotta); }
  .cart-item__price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    margin-top: 2px;
  }
  .cart-item__price strong { font-weight: 500; }
  .cart-item__price-x {
    color: var(--ink-mute);
    font-style: italic;
    font-size: 0.85rem;
    margin: 0 0.3em;
  }
  .cart-item__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--bg-deep);
    border-radius: var(--r-pill);
    overflow: hidden;
    margin-top: var(--space-3);
    align-self: flex-start;
  }
  .cart-item__qty button {
    width: 36px;
    height: 36px;
    background: var(--bg);
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft);
  }
  .cart-item__qty button:hover { background: var(--ink); color: var(--bg-soft); }
  .cart-item__qty span {
    padding: 0 var(--space-3);
    font-family: var(--font-body);
    font-size: 0.95rem;
    min-width: 2.5rem;
    text-align: center;
  }
  .cart-item__remove {
    align-self: flex-start;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: var(--ink-mute);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s var(--ease-soft);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cart-item__remove:hover { background: var(--terracotta); color: var(--bg-soft); }
  .cart-item + .cart-item { margin-top: var(--space-3); }
</style>

<script
  define:vars={{
    products,
    freeShippingThreshold: SITE.freeShippingThreshold,
    shippingCost: SITE.shippingCost,
    promoCode: SITE.promoCode,
    promoDiscount: SITE.promoDiscount,
  }}
>
  const fmt = (n) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(n);
  const STORAGE_KEY = 'candele-cart';
  const PRODUCT_BY_ID = Object.fromEntries(products.map((p) => [p.id, p]));

  const readCart = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { items: [] };
      const parsed = JSON.parse(raw);
      if (parsed && Array.isArray(parsed.items)) return parsed;
    } catch (e) {}
    return { items: [] };
  };
  const writeCart = (cart) => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
  };
  const showToast = (message, type = 'success') => {
    window.dispatchEvent(new CustomEvent('toast:show', { detail: { message, type } }));
  };

  let appliedPromo = null;

  function renderCart() {
    const cart = readCart();
    const items = cart.items;
    const list = document.querySelector('[data-cart-list]');
    const empty = document.querySelector('[data-cart-empty]');
    const summary = document.querySelector('[data-cart-summary]');
    const checkoutBtn = document.querySelector('[data-cart-checkout]');

    if (!items.length) {
      if (list) { list.hidden = true; list.innerHTML = ''; }
      if (empty) empty.style.display = '';
      if (summary) summary.hidden = true;
      if (checkoutBtn) {
        checkoutBtn.classList.add('is-disabled');
        checkoutBtn.setAttribute('aria-disabled', 'true');
      }
      return;
    }
    if (empty) empty.style.display = 'none';
    if (list) {
      list.hidden = false;
      list.innerHTML = items.map((it) => {
        const p = PRODUCT_BY_ID[it.id];
        if (!p) return '';
        const lineTotal = fmt(p.price * it.qty);
        const priceLine = it.qty > 1
          ? `${fmt(p.price)} <span class="cart-item__price-x">c/u</span> · <strong>${lineTotal}</strong>`
          : `<strong>${lineTotal}</strong>`;
        return `
          <li class="cart-item" data-id="${p.id}">
            <a href="/producto/${p.id}" class="cart-item__media" aria-label="Ver ${p.name}">
              <img src="${p.image}" alt="${p.imageAlt}" loading="lazy" />
            </a>
            <div class="cart-item__body">
              <p class="cart-item__cat">${p.category}</p>
              <a href="/producto/${p.id}" class="cart-item__name">${p.name}</a>
              <p class="cart-item__price">${priceLine}</p>
              <div class="cart-item__qty">
                <button data-qty-down="${p.id}" aria-label="Restar una unidad" type="button">−</button>
                <span>${it.qty}</span>
                <button data-qty-up="${p.id}" aria-label="Sumar una unidad" type="button">+</button>
              </div>
            </div>
            <button class="cart-item__remove" data-remove="${p.id}" aria-label="Eliminar ${p.name}" type="button">×</button>
          </li>`;
      }).join('');
    }
    if (summary) summary.hidden = false;
    if (checkoutBtn) {
      checkoutBtn.classList.remove('is-disabled');
      checkoutBtn.removeAttribute('aria-disabled');
    }

    const subtotal = items.reduce((s, it) => {
      const p = PRODUCT_BY_ID[it.id];
      return p ? s + p.price * it.qty : s;
    }, 0);
    const discount = appliedPromo ? subtotal * appliedPromo.discount : 0;
    const subtotalAfter = subtotal - discount;
    const shipping = subtotalAfter >= freeShippingThreshold ? 0 : shippingCost;
    const total = subtotalAfter + shipping;

    const setText = (sel, val) => { const el = document.querySelector(sel); if (el) el.textContent = val; };
    setText('[data-cart-subtotal]', fmt(subtotal));
    setText('[data-cart-shipping]', shipping === 0 ? 'Gratis ✦' : fmt(shipping));
    setText('[data-cart-total]', fmt(total));

    const prog = document.querySelector('[data-cart-progress]');
    if (prog) {
      if (shipping > 0) {
        const remaining = freeShippingThreshold - subtotalAfter;
        prog.hidden = false;
        prog.textContent = `Te faltan ${fmt(remaining)} para envío gratis`;
      } else {
        prog.hidden = true;
      }
    }
  }

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;

    const qtyUp = t.closest('[data-qty-up]');
    if (qtyUp) {
      e.preventDefault();
      const id = Number(qtyUp.dataset.qtyUp);
      const c = readCart();
      const it = c.items.find((x) => x.id === id);
      if (it) it.qty += 1;
      writeCart(c);
      renderCart();
      return;
    }
    const qtyDown = t.closest('[data-qty-down]');
    if (qtyDown) {
      e.preventDefault();
      const id = Number(qtyDown.dataset.qtyDown);
      const c = readCart();
      const it = c.items.find((x) => x.id === id);
      if (it) {
        it.qty -= 1;
        if (it.qty <= 0) {
          c.items = c.items.filter((x) => x.id !== id);
          showToast('Vela eliminada de la cesta', 'info');
        }
      }
      writeCart(c);
      renderCart();
      return;
    }
    const rm = t.closest('[data-remove]');
    if (rm) {
      e.preventDefault();
      const id = Number(rm.dataset.remove);
      const p = PRODUCT_BY_ID[id];
      const c = readCart();
      c.items = c.items.filter((x) => x.id !== id);
      writeCart(c);
      renderCart();
      if (p) showToast(`${p.name} eliminada de la cesta`, 'info');
      return;
    }

    if (t.matches('[data-promo-apply]')) {
      const input = document.querySelector('[data-promo-input]');
      const status = document.querySelector('[data-promo-status]');
      const code = (input?.value || '').trim().toUpperCase();
      if (code === promoCode.toUpperCase()) {
        appliedPromo = { code, discount: promoDiscount };
        if (status) { status.textContent = `${code} aplicado ✦`; status.classList.remove('is-error'); }
        showToast(`Cupón ${code} aplicado ✦`, 'success');
      } else if (code) {
        appliedPromo = null;
        if (status) { status.textContent = 'Cupón no válido'; status.classList.add('is-error'); }
        showToast('Ese cupón no es válido', 'error');
      }
      renderCart();
    }
  });

  window.addEventListener('cart:updated', renderCart);
  renderCart();
</script>
