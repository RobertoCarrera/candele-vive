---
/**
 * Página de colección — optimizada para SEO + GEO (LLMs).
 * - Hero con datos concretos (año, número de velas, peso, duración)
 * - Intro largo, declarativo, citable
 * - Bloque "Para quién es / Para qué momento" con datos
 * - Grid de productos con JSON-LD ItemList
 * - FAQ con JSON-LD FAQPage (people also ask)
 * - BreadcrumbList
 * - Cross-link a las otras 4 colecciones
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import Wave from '../../components/decorative/Wave.astro';
import { getCollection, render } from 'astro:content';
import { COLLECTIONS_CONTENT, type CollectionSlug } from '../../data/collections-content';
import { collectionHero } from '../../lib/images';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const collections = await getCollection('collections');
  return collections.map((c) => ({
    params: { slug: c.data.slug },
    props: { collection: c },
  }));
}

const { collection } = Astro.props;
const { Content } = await render(collection);

const slug = collection.data.slug as CollectionSlug;
const content = COLLECTIONS_CONTENT[slug];

const allProducts = (await getCollection('products'))
  .filter((p) => p.data.collection === collection.data.slug)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const otherCollections = (await getCollection('collections'))
  .filter((c) => c.data.slug !== collection.data.slug)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const SHIFTS = ['none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up'];

// Datos estructurados
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Colecciones', item: SITE.url + '/colecciones' },
      { '@type': 'ListItem', position: 3, name: collection.data.name, item: new URL(Astro.url.pathname, SITE.url).toString() },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: content.metaTitle,
    description: content.metaDescription,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    isPartOf: { '@id': SITE.url + '#website' },
    about: { '@type': 'Thing', name: `Velas aromáticas de ${collection.data.season}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Colección ${collection.data.name}`,
    description: content.ogDescription,
    numberOfItems: allProducts.length,
    itemListElement: allProducts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/producto/${p.data.id}`, SITE.url).toString(),
      name: p.data.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  jsonLd={jsonLd}
  bodyClass={`page-collection page-collection--${slug}`}
>
  <nav class="col-crumbs container" aria-label="Migas de pan">
    <a href="/">Inicio</a>
    <span aria-hidden="true">·</span>
    <a href="/colecciones">Colecciones</a>
    <span aria-hidden="true">·</span>
    <span>{collection.data.name}</span>
  </nav>

  <header class="col-hero">
    <div class="container col-hero__inner">
      <p class="eyebrow col-hero__eyebrow">
        Colección de {collection.data.season.toLowerCase()} · desde {content.foundedYear}
      </p>
      <h1 class="col-hero__title">
        {collection.data.name}
      </h1>
      {collection.data.heroTagline && (
        <p class="col-hero__tag">{collection.data.heroTagline}</p>
      )}
      <Wave class="col-hero__wave" color="var(--terracotta)" />
      <p class="col-hero__sub">
        {content.candleCount} {content.candleCount === 1 ? 'vela' : 'velas'} ·
        {content.burnTime} de duración · {content.weight}
      </p>
    </div>
    <div class="container-wide col-hero__art">
      <img
        src={collectionHero(slug)}
        alt={`Imagen de la Colección ${collection.data.name} (${collection.data.season})`}
        class="col-hero__img"
        loading="eager"
        decoding="async"
      />
    </div>
  </header>

  <section class="col-intro">
    <div class="container col-intro__inner">
      <h2 class="col-intro__title">{content.introTitle}</h2>
      <div class="col-intro__body">
        {content.introBody.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="col-facts">
    <div class="container-wide">
      <ul class="col-facts__grid">
        <li class="col-fact">
          <span class="col-fact__label">Aroma principal</span>
          <span class="col-fact__value">{content.scentProfile.primary}</span>
        </li>
        <li class="col-fact">
          <span class="col-fact__label">Aroma secundario</span>
          <span class="col-fact__value">{content.scentProfile.secondary}</span>
        </li>
        <li class="col-fact">
          <span class="col-fact__label">Toque</span>
          <span class="col-fact__value">{content.scentProfile.accent}</span>
        </li>
        <li class="col-fact">
          <span class="col-fact__label">Temporada</span>
          <span class="col-fact__value">{content.seasonMonths}</span>
        </li>
        <li class="col-fact">
          <span class="col-fact__label">Cera</span>
          <span class="col-fact__value">Soja 100% natural</span>
        </li>
        <li class="col-fact">
          <span class="col-fact__label">Mecha</span>
          <span class="col-fact__value">Algodón sin plomo</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="col-products section">
    <div class="container-wide">
      <header class="col-products__head">
        <p class="eyebrow">las velas de esta colección</p>
        <h2 class="col-products__title">
          {allProducts.length} {allProducts.length === 1 ? 'vela disponible' : 'velas disponibles'}
        </h2>
      </header>

      {allProducts.length > 0 ? (
        <ul class="col-products__grid">
          {allProducts.map((p, i) => (
            <li>
              <ProductCard
                id={p.data.id}
                name={p.data.name}
                price={p.data.price}
                category={p.data.category}
                collection={p.data.collection}
                image={p.data.image}
                imageAlt={p.data.imageAlt}
                burnTime={p.data.burnTime}
                size={p.data.size}
                badge={p.data.badge}
                shortDescription={p.data.shortDescription}
                order={p.data.order}
                shift={SHIFTS[i % SHIFTS.length] as 'up' | 'down' | 'none'}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="col-products__empty">
          Esta colección está en preparación. Vuelve pronto.
        </p>
      )}
    </div>
  </section>

  <section class="col-fit section">
    <div class="container col-fit__inner">
      <div class="col-fit__col">
        <h2 class="col-fit__title">Para quién es</h2>
        <p class="col-fit__body">{content.bestFor}</p>
      </div>
      <div class="col-fit__col">
        <h2 class="col-fit__title">Cuándo encenderla</h2>
        <ul class="col-fit__chips">
          {content.occasions.map((o) => <li class="col-fit__chip">{o}</li>)}
        </ul>
      </div>
      <div class="col-fit__col">
        <h2 class="col-fit__title">No es para</h2>
        <p class="col-fit__body col-fit__body--mute">{content.notFor}</p>
      </div>
    </div>
  </section>

  <section class="col-md">
    <div class="container col-md__inner">
      <h2 class="col-md__title">Cómo se hacen</h2>
      <p class="col-md__body">
        {content.processNotes} Cada vela se elabora en el taller de
        <strong>{content.origin}</strong>, en lotes de entre 30 y 60 unidades.
        El control de calidad es manual: revisamos mecha, fragancia y superficie
        antes de etiquetar.
      </p>
      <p class="col-md__body">
        Más detalles sobre el proceso completo en <a href="/taller">El Taller</a>.
      </p>
    </div>
  </section>

  <section class="col-faq section">
    <div class="container col-faq__inner">
      <header class="col-faq__head">
        <p class="eyebrow">preguntas frecuentes</p>
        <h2 class="col-faq__title">Sobre la Colección {collection.data.name}</h2>
        <Wave class="col-faq__wave" color="var(--terracotta)" />
      </header>

      <ul class="col-faq__list" data-faq>
        {content.faqs.map((f) => (
          <li class="col-faq__item">
            <details>
              <summary class="col-faq__q">
                <span>{f.q}</span>
                <span class="col-faq__icon" aria-hidden="true">+</span>
              </summary>
              <p class="col-faq__a">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>

      <div class="col-faq__paa">
        <h3 class="col-faq__paa-title">La gente también pregunta</h3>
        <dl class="col-faq__paa-list">
          {content.peopleAlsoAsk.map((f) => (
            <div class="col-faq__paa-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="col-others section">
    <div class="container">
      <p class="eyebrow col-others__eyebrow">y también</p>
      <h2 class="col-others__title">Las otras colecciones</h2>
      <ul class="col-others__list">
        {otherCollections.map((c) => {
          const oc = COLLECTIONS_CONTENT[c.data.slug as CollectionSlug];
          return (
            <li>
              <a href={`/coleccion/${c.data.slug}`} class="col-others__link">
                <span class="col-others__season">{c.data.season}</span>
                <span class="col-others__name">{c.data.name}</span>
                <span class="col-others__hint">{oc.candleCount} velas · {oc.burnTime.split(' ')[0]} h</span>
                <span class="col-others__arrow">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .col-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-block: var(--space-6);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-mute);
  }
  .col-crumbs a:hover { color: var(--terracotta); }
  .col-crumbs span:last-child { color: var(--ink); font-style: italic; font-family: var(--font-display); font-size: 0.95rem; }

  /* === HERO === */
  .col-hero {
    padding-block: var(--space-8) var(--space-12);
    text-align: center;
    background: var(--bg);
  }
  .col-hero__inner { max-width: 48rem; margin-inline: auto; }
  .col-hero__eyebrow { color: var(--sage); }
  .col-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 6rem);
    line-height: 0.95;
    margin-top: var(--space-3);
    color: var(--ink);
  }
  .col-hero__tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    color: var(--ink-mute);
    margin-top: var(--space-4);
    max-width: 32rem;
    margin-inline: auto;
  }
  .col-hero__wave { width: 120px; height: 12px; margin: var(--space-6) auto 0; }
  .col-hero__sub {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-mute);
    margin-top: var(--space-3);
    letter-spacing: 0.04em;
  }

  /* === INTRO === */
  .col-intro { background: var(--bg); padding-block: var(--space-8) var(--space-16); }
  .col-intro__inner { max-width: 44rem; margin-inline: auto; }
  .col-intro__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: var(--space-6);
    font-style: italic;
  }
  .col-intro__body { display: flex; flex-direction: column; gap: var(--space-4); }
  .col-intro__body p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .col-intro__body p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 400;
    color: var(--terracotta);
    float: left;
    line-height: 0.9;
    padding: 0.2rem 0.6rem 0 0;
    margin-top: 0.1em;
  }

  /* === FACTS === */
  .col-facts { background: var(--bg-warm); padding-block: var(--space-12); }
  .col-facts__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--bg-deep);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 700px)  { .col-facts__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .col-facts__grid { grid-template-columns: repeat(6, 1fr); } }
  .col-fact {
    background: var(--bg-warm);
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }
  .col-fact__label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: var(--space-2);
  }
  .col-fact__value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
    line-height: 1.3;
  }

  /* === PRODUCTS === */
  .col-products { background: var(--bg-soft); }
  .col-products__head { text-align: center; margin-bottom: var(--space-12); }
  .col-products__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: var(--space-2);
  }
  .col-products__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-6);
  }
  @media (min-width: 700px)  { .col-products__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .col-products__grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-16) var(--space-6); } }
  .col-products__empty {
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 1.1rem;
    padding-block: var(--space-12);
  }

  /* === FIT (para quién / cuándo / no es para) === */
  .col-fit { background: var(--bg); }
  .col-fit__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 800px) { .col-fit__inner { grid-template-columns: repeat(3, 1fr); gap: var(--space-8); } }
  .col-fit__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--bg-deep);
  }
  .col-fit__body {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .col-fit__body--mute { color: var(--ink-mute); font-style: italic; }
  .col-fit__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .col-fit__chip {
    padding: 0.4rem 0.9rem;
    background: var(--bg-soft);
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* === MD (cómo se hacen) === */
  .col-md {
    background: var(--bg-warm);
    padding-block: var(--space-16);
  }
  .col-md__inner { max-width: 44rem; margin-inline: auto; text-align: center; }
  .col-md__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-style: italic;
    margin-bottom: var(--space-6);
  }
  .col-md__body {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }
  .col-md__body a {
    color: var(--terracotta);
    border-bottom: 1px solid currentColor;
  }
  .col-md__body strong { color: var(--ink); font-weight: 500; }

  /* === FAQ === */
  .col-faq { background: var(--bg-soft); }
  .col-faq__inner { max-width: 48rem; }
  .col-faq__head { text-align: center; margin-bottom: var(--space-12); }
  .col-faq__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-top: var(--space-2);
  }
  .col-faq__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .col-faq__list { display: flex; flex-direction: column; gap: var(--space-2); }
  .col-faq__item {
    background: var(--bg);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .col-faq__q {
    cursor: pointer;
    list-style: none;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .col-faq__q::-webkit-details-marker { display: none; }
  .col-faq__icon {
    color: var(--terracotta);
    font-size: 1.4rem;
    font-weight: 300;
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-soft);
  }
  details[open] .col-faq__icon { transform: rotate(45deg); }
  .col-faq__a {
    padding: 0 var(--space-6) var(--space-6);
    font-family: var(--font-display);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }
  .col-faq__paa {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--bg-deep);
  }
  .col-faq__paa-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    margin-bottom: var(--space-6);
  }
  .col-faq__paa-list { display: flex; flex-direction: column; gap: var(--space-3); }
  .col-faq__paa-item {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--bg-deep);
  }
  .col-faq__paa-item dt {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .col-faq__paa-item dd {
    font-family: var(--font-display);
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* === OTHERS === */
  .col-others { background: var(--bg); }
  .col-others__eyebrow { text-align: center; }
  .col-others__title {
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-block: var(--space-2) var(--space-8);
  }
  .col-others__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    max-width: 56rem;
    margin-inline: auto;
  }
  @media (min-width: 700px) { .col-others__list { grid-template-columns: repeat(2, 1fr); } }
  .col-others__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--bg-soft);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--ink);
    transition: all 0.4s var(--ease-soft);
  }
  .col-others__link:hover {
    background: var(--terracotta-soft);
  }
  .col-others__season {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
    grid-row: span 2;
    align-self: center;
    width: 7rem;
  }
  .col-others__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .col-others__hint {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-mute);
    grid-column: 2;
  }
  .col-others__arrow {
    color: var(--terracotta);
    font-size: 1.2rem;
    grid-row: span 2;
    align-self: center;
  }
</style>
