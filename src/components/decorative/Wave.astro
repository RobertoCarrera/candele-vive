---
/**
 * Wave — la única decoración recurrente. Una línea ondulada, hecha a mano.
 * Se usa entre secciones para dar respiro. Color heredado de currentColor.
 */
interface Props {
  class?: string;
  color?: string;
}

const { class: className = '', color = 'currentColor' } = Astro.props;
---

<svg
  viewBox="0 0 200 12"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`wave ${className}`}
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <path
    d="M0 6 Q 20 0 40 6 T 80 6 T 120 6 T 160 6 T 200 6"
    stroke={color}
    stroke-width="1.2"
    stroke-linecap="round"
    fill="none"
  />
  <circle cx="100" cy="6" r="1.6" fill={color} opacity="0.6" />
</svg>
