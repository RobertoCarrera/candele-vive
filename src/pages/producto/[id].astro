---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import Wave from '../../components/decorative/Wave.astro';
import { getCollection, render } from 'astro:content';
import { formatPrice } from '../../lib/format';
import { SITE } from '../../data/site';
import { UI } from '../../data/ui';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { id: String(p.data.id) },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const allProducts = await getCollection('products');
const collections = await getCollection('collections');
const coll = collections.find((c) => c.data.slug === product.data.collection);
const related = allProducts
  .filter((p) => p.data.collection === product.data.collection && p.data.id !== product.data.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3);

const title = `${product.data.name} · Candele Vive`;
const description = product.data.shortDescription;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.name,
  description: product.data.shortDescription,
  image: new URL(product.data.image, SITE.url).toString(),
  category: product.data.category,
  brand: { '@type': 'Brand', name: SITE.name },
  offers: {
    '@type': 'Offer',
    price: product.data.price.toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: new URL(Astro.url.pathname, SITE.url).toString(),
  },
};
---

<BaseLayout title={title} description={description} type="product" jsonLd={jsonLd}>
  <nav class="pdp__crumbs container" aria-label="Migas de pan">
    <a href="/">Inicio</a>
    <span aria-hidden="true">·</span>
    <a href="/catalogo">{UI.product.breadcrumb.shop}</a>
    {coll && (
      <>
        <span aria-hidden="true">·</span>
        <a href={`/coleccion/${coll.data.slug}`}>{coll.data.name}</a>
      </>
    )}
    <span aria-hidden="true">·</span>
    <span class="pdp__crumb-current">{product.data.name}</span>
  </nav>

  <article class="pdp">
    <div class="container-wide pdp__grid">
      <button type="button" class="pdp__media" data-pdp-zoom aria-label="Ver imagen ampliada">
        <img src={product.data.image} alt={product.data.imageAlt} loading="eager" decoding="async" />
        <span class="pdp__zoom-hint" aria-hidden="true">+</span>
        {product.data.badge && <span class="pdp__badge">{product.data.badge}</span>}
      </button>

      {/* Lightbox / zoom fullscreen */}
      <div class="pdp-lightbox" data-pdp-lightbox hidden aria-hidden="true">
        <button type="button" class="pdp-lightbox__close" data-pdp-lightbox-close aria-label="Cerrar">×</button>
        <img src={product.data.image} alt={product.data.imageAlt} class="pdp-lightbox__img" />
      </div>

      <div class="pdp__info">
        <p class="pdp__cat">
          {coll?.data.name ?? product.data.category}
          {product.data.badge && <span> · {product.data.badge}</span>}
        </p>
        <h1 class="pdp__title">{product.data.name}</h1>

        <Wave class="pdp__rule" color="var(--terracotta)" />

        <p class="pdp__short">{product.data.shortDescription}</p>

        <div class="pdp__price-row">
          <p class="pdp__price">{formatPrice(product.data.price)}</p>
          <p class="pdp__price-meta">IVA incluido · envío 2-3 días</p>
        </div>

        <div class="pdp__cta-row">
          <div class="pdp__qty" data-pdp-qty>
            <button type="button" class="pdp__qty-btn" data-pdp-qty-down aria-label="Restar una unidad">−</button>
            <input
              type="number"
              class="pdp__qty-input"
              min="1"
              max="99"
              step="1"
              value="1"
              data-pdp-qty-input
              aria-label="Cantidad"
            />
            <button type="button" class="pdp__qty-btn" data-pdp-qty-up aria-label="Sumar una unidad">+</button>
          </div>
          <button class="btn btn-primary pdp__add" data-add-to-cart={product.data.id}>
            <span data-label>{UI.buttons.addToCart}</span>
          </button>
          <a href="/cesta" class="btn btn-ghost">{UI.buttons.viewCart}</a>
        </div>

        <ul class="pdp__specs">
          {product.data.burnTime && product.data.burnTime !== 'N/A' && (
            <li><span>{UI.product.specs.duration}</span><strong>{product.data.burnTime}</strong></li>
          )}
          {product.data.size && (
            <li><span>{UI.product.specs.size}</span><strong>{product.data.size}</strong></li>
          )}
          {product.data.waxType && (
            <li><span>{UI.product.specs.wax}</span><strong>{product.data.waxType}</strong></li>
          )}
          {product.data.wick && (
            <li><span>{UI.product.specs.wick}</span><strong>{product.data.wick}</strong></li>
          )}
        </ul>
      </div>
    </div>
  </article>

  <section class="pdp-tabs section">
    <div class="container">
      <div class="pdp-tabs__inner" data-pdp-tabs>
        <div class="pdp-tabs__nav" role="tablist">
          <button class="pdp-tabs__btn is-active" data-tab="details" role="tab" aria-selected="true">{UI.product.tabs.details}</button>
          <button class="pdp-tabs__btn" data-tab="ingredients" role="tab" aria-selected="false">{UI.product.tabs.ingredients}</button>
          <button class="pdp-tabs__btn" data-tab="shipping" role="tab" aria-selected="false">{UI.product.tabs.shipping}</button>
        </div>

        <div class="pdp-tabs__panels">
          <div class="pdp-tabs__panel is-active" data-panel="details" role="tabpanel">
            <div class="prose">
              <Content />
            </div>
          </div>
          <div class="pdp-tabs__panel" data-panel="ingredients" role="tabpanel" hidden>
            <ul class="pdp-list">
              {UI.product.ingredients.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
          <div class="pdp-tabs__panel" data-panel="shipping" role="tabpanel" hidden>
            <ul class="pdp-list">
              {UI.product.shippingInfo.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="pdp-related section">
      <div class="container-wide">
        <header class="pdp-related__head">
          <p class="eyebrow">{UI.product.relatedTagline}</p>
          <h2 class="pdp-related__title">{UI.product.relatedTitle}</h2>
          <Wave class="pdp-related__wave" color="var(--terracotta)" />
        </header>
        <ul class="pdp-related__grid">
          {related.map((p) => (
            <li>
              <ProductCard
                id={p.data.id}
                name={p.data.name}
                price={p.data.price}
                category={p.data.category}
                collection={p.data.collection}
                image={p.data.image}
                imageAlt={p.data.imageAlt}
                burnTime={p.data.burnTime}
                size={p.data.size}
                badge={p.data.badge}
                shortDescription={p.data.shortDescription}
                order={p.data.order}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .pdp__crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-block: var(--space-6);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--ink-mute);
  }
  .pdp__crumbs a:hover { color: var(--terracotta); }
  .pdp__crumb-current { color: var(--ink); font-style: italic; font-family: var(--font-display); font-size: 0.95rem; }

  .pdp { padding-block: var(--space-4) var(--space-20); }
  .pdp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 1000px) {
    .pdp__grid { grid-template-columns: 1.1fr 1fr; gap: var(--space-16); }
  }

  .pdp__media {
    position: relative;
    background: var(--bg-soft);
    border-radius: var(--r-xl);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    box-shadow: var(--sh-2);
    border: 0;
    padding: 0;
    width: 100%;
    cursor: zoom-in;
    display: block;
  }
  .pdp__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pdp__zoom-hint {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(244, 238, 224, 0.9);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.3s var(--ease-soft), background 0.3s var(--ease-soft);
  }
  .pdp__media:hover .pdp__zoom-hint {
    background: var(--terracotta);
    color: var(--bg-soft);
    transform: scale(1.1);
  }

  /* === Lightbox / zoom === */
  .pdp-lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(45, 33, 27, 0.92);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    animation: lb-fade 0.3s var(--ease-soft);
  }
  .pdp-lightbox[hidden] { display: none; }
  .pdp-lightbox__img {
    max-width: 92vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--r-md);
    box-shadow: 0 20px 60px -20px rgba(0,0,0,0.5);
  }
  .pdp-lightbox__close {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgba(244, 238, 224, 0.15);
    color: var(--bg-soft);
    font-size: 1.5rem;
    cursor: pointer;
    transition: background 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .pdp-lightbox__close:hover {
    background: var(--terracotta);
    transform: rotate(90deg);
  }
  @keyframes lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .pdp__badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 0.4rem 0.9rem;
    background: rgba(244, 238, 224, 0.95);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--r-pill);
  }

  .pdp__cat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .pdp__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .pdp__rule { width: 80px; height: 12px; margin-block: var(--space-4); }
  .pdp__short {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .pdp__price-row { margin-top: var(--space-6); }
  .pdp__price {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--ink);
    font-weight: 500;
  }
  .pdp__price-meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-mute);
    margin-top: 4px;
  }

  .pdp__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
    align-items: stretch;
  }
  .pdp__add { min-width: 200px; flex: 1 1 auto; }
  .pdp__add.is-added {
    background: var(--sage);
  }

  /* === Selector de cantidad === */
  .pdp__qty {
    display: inline-flex;
    align-items: center;
    background: var(--bg-soft);
    border: 1px solid var(--bg-deep);
    border-radius: var(--r-pill);
    overflow: hidden;
  }
  .pdp__qty-btn {
    width: 44px;
    height: 100%;
    min-height: 48px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft);
  }
  .pdp__qty-btn:hover { background: var(--ink); color: var(--bg-soft); }
  .pdp__qty-btn:active { background: var(--terracotta); color: var(--bg-soft); }
  .pdp__qty-input {
    width: 48px;
    height: 100%;
    min-height: 48px;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 500;
    padding: 0;
    -moz-appearance: textfield;
  }
  .pdp__qty-input::-webkit-outer-spin-button,
  .pdp__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .pdp__qty-input:focus {
    outline: none;
    background: var(--bg);
  }

  .pdp__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--bg-deep);
  }
  @media (min-width: 600px) { .pdp__specs { grid-template-columns: repeat(4, 1fr); } }
  .pdp__specs li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pdp__specs li span {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pdp__specs li strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 400;
  }

  .pdp-tabs { background: var(--bg-soft); padding-block: var(--space-16); }
  .pdp-tabs__inner { max-width: 48rem; margin-inline: auto; }
  .pdp-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    border-bottom: 1px solid var(--bg-deep);
    margin-bottom: var(--space-8);
  }
  .pdp-tabs__btn {
    background: transparent;
    border: 0;
    padding: 0.75rem 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--ink-mute);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft);
  }
  .pdp-tabs__btn.is-active { color: var(--ink); border-bottom-color: var(--terracotta); }

  .pdp-tabs__panel[hidden] { display: none; }
  .pdp-tabs__panel { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.7; color: var(--ink-soft); }
  .pdp-tabs__panel .prose :global(h2) { font-size: 1.5rem; color: var(--terracotta); font-style: italic; margin-block: var(--space-6) var(--space-3); }
  .pdp-tabs__panel .prose :global(strong) { color: var(--ink); font-weight: 500; }
  .pdp-tabs__panel .prose :global(ul) { list-style: disc; padding-left: var(--space-6); }
  .pdp-tabs__panel .prose :global(ul li) { margin-bottom: var(--space-2); }

  .pdp-list { display: flex; flex-direction: column; gap: var(--space-3); }
  .pdp-list li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--bg-deep);
  }
  .pdp-list li:last-child { border-bottom: 0; }

  .pdp-related { background: var(--bg); }
  .pdp-related__head { text-align: center; margin-bottom: var(--space-12); }
  .pdp-related__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: var(--space-2);
  }
  .pdp-related__wave { width: 120px; height: 12px; margin: var(--space-4) auto 0; }
  .pdp-related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 700px)  { .pdp-related__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .pdp-related__grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  const tabRoot = document.querySelector('[data-pdp-tabs]');
  if (tabRoot) {
    const buttons = tabRoot.querySelectorAll<HTMLButtonElement>('.pdp-tabs__btn');
    const panels = tabRoot.querySelectorAll<HTMLElement>('.pdp-tabs__panel');
    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        const target = b.dataset.tab;
        buttons.forEach((x) => {
          x.classList.toggle('is-active', x === b);
          x.setAttribute('aria-selected', x === b ? 'true' : 'false');
        });
        panels.forEach((p) => {
          const isActive = p.dataset.panel === target;
          p.classList.toggle('is-active', isActive);
          p.hidden = !isActive;
        });
      });
    });
  }

  // === Selector de cantidad (− N +) ===
  const qtyWrap = document.querySelector<HTMLElement>('[data-pdp-qty]');
  const qtyInput = qtyWrap?.querySelector<HTMLInputElement>('[data-pdp-qty-input]');
  const qtyDown = qtyWrap?.querySelector<HTMLButtonElement>('[data-pdp-qty-down]');
  const qtyUp   = qtyWrap?.querySelector<HTMLButtonElement>('[data-pdp-qty-up]');
  const clampQty = (n: number) => Math.max(1, Math.min(99, Math.floor(n) || 1));
  const syncQty = () => { if (qtyInput) qtyInput.value = String(clampQty(Number(qtyInput.value))); };
  qtyDown?.addEventListener('click', () => { if (qtyInput) { qtyInput.value = String(clampQty(Number(qtyInput.value) - 1)); } });
  qtyUp?.addEventListener('click',   () => { if (qtyInput) { qtyInput.value = String(clampQty(Number(qtyInput.value) + 1)); } });
  qtyInput?.addEventListener('blur',  syncQty);
  qtyInput?.addEventListener('change', syncQty);

  // === Lightbox / zoom de la imagen ===
  const zoomBtn   = document.querySelector<HTMLButtonElement>('[data-pdp-zoom]');
  const lightbox  = document.querySelector<HTMLElement>('[data-pdp-lightbox]');
  const lbClose   = document.querySelector<HTMLButtonElement>('[data-pdp-lightbox-close]');
  const openLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = false;
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };
  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };
  zoomBtn?.addEventListener('click', openLightbox);
  lbClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox(); });

  // === Add to cart con cantidad ===
  const addBtn = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
  addBtn?.addEventListener('click', () => {
    const id = Number(addBtn.dataset.addToCart);
    if (!id) return;
    const qty = qtyInput ? clampQty(Number(qtyInput.value)) : 1;
    try {
      const raw = localStorage.getItem('candele-cart');
      const cart = raw ? JSON.parse(raw) : { items: [] as { id: number; qty: number }[] };
      if (!Array.isArray(cart.items)) cart.items = [];
      const existing = cart.items.find((i: { id: number; qty: number }) => i.id === id);
      if (existing) existing.qty += qty;
      else cart.items.push({ id, qty });
      localStorage.setItem('candele-cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));

      // Feedback inmediato en el botón
      const label = addBtn.querySelector<HTMLElement>('[data-label]');
      if (label) {
        const original = label.textContent;
        const msg = qty > 1 ? `${qty} velas en la cesta ✦` : 'En la cesta ✦';
        label.textContent = msg;
        addBtn.classList.add('is-added');
        setTimeout(() => {
          if (label.textContent === msg) label.textContent = original ?? '';
          addBtn.classList.remove('is-added');
        }, 2000);
      }

      // Toast + abrir drawer
      const name = document.querySelector('h1')?.textContent?.trim() || 'Vela';
      const toastMsg = qty > 1 ? `${qty} × ${name} añadidas a la cesta` : `${name} añadida a la cesta`;
      window.dispatchEvent(new CustomEvent('toast:show', {
        detail: { type: 'success', message: toastMsg },
      }));
      window.dispatchEvent(new CustomEvent('cart:open'));
    } catch (e) { /* noop */ }
  });
</script>
