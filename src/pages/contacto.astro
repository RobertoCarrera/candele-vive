---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/decorative/Wave.astro';
import { SITE, whatsappLink, whatsappDisplay } from '../data/site';
import { UI } from '../data/ui';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE.url}/contacto#business`,
    name: SITE.legalName,
    image: `${SITE.url}/og-image.svg`,
    url: SITE.url,
    telephone: SITE.phone,
    email: SITE.email,
    priceRange: '€€',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 41.2244,
      longitude: 1.7256,
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '10:00',
        closes: '18:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '11:00',
        closes: '14:00',
      },
    ],
    sameAs: [SITE.social.instagram, SITE.social.facebook, SITE.social.pinterest].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: SITE.url + '/contacto' },
    ],
  },
];
---

<BaseLayout title={UI.contact.title} description={UI.contact.intro} jsonLd={jsonLd}>
  <header class="ct-hero">
    <div class="container">
      <p class="eyebrow">{UI.contact.tagline}</p>
      <h1 class="ct-hero__title">{UI.contact.headline}</h1>
      <Wave class="ct-hero__wave" color="var(--terracotta)" />
      <p class="ct-hero__lede">{UI.contact.intro}</p>
    </div>
  </header>

  <section class="ct-grid section">
    <div class="container-wide ct-grid__inner">
      <aside class="ct-aside">
        <h2 class="ct-aside__title">Cómo encontrarnos</h2>

        <div class="ct-info">
          <p class="ct-info__label">Email</p>
          <a href={`mailto:${SITE.email}`} class="ct-info__value">{SITE.email}</a>
          <p class="ct-info__hint">{UI.contact.hoursEmail}</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">WhatsApp</p>
          <a href={whatsappLink('Hola, me gustaría información sobre una vela Candele Vive')} class="ct-info__value" target="_blank" rel="noopener noreferrer">{whatsappDisplay()}</a>
          <p class="ct-info__hint">{UI.contact.hoursPhone}</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">Estudio</p>
          <p class="ct-info__value">{SITE.address.locality}</p>
          <p class="ct-info__hint">{SITE.address.region}, {SITE.address.postalCode} — cita previa</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">Síguenos</p>
          <ul class="ct-social">
            <li><a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
            <li><a href={SITE.social.pinterest} target="_blank" rel="noopener noreferrer">Pinterest</a></li>
          </ul>
        </div>
      </aside>

      <div class="ct-form">
        <h2 class="ct-form__title">Escríbenos por WhatsApp</h2>
        <p class="ct-form__lede">
          Es lo más rápido. Solemos contestar en menos de dos horas durante
          el horario del taller, y si nos escribes por la noche te leemos
          a primera hora del día siguiente.
        </p>
        <a
          class="btn btn-primary ct-form__whatsapp"
          href={whatsappLink('Hola, me gustaría haceros una pregunta sobre una vela Candele Vive ✦')}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12c0 1.94.55 3.74 1.49 5.27L2 22l4.84-1.46A9.96 9.96 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.6 14.2c-.24.66-1.38 1.27-1.94 1.34-.5.07-1.13.1-1.83-.12-.42-.13-.96-.31-1.66-.61-2.93-1.27-4.84-4.24-4.99-4.44-.15-.2-1.18-1.57-1.18-2.99s.75-2.12 1.01-2.41c.26-.29.57-.36.77-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 1.01 2.16.07.14.13.31.02.5-.1.2-.15.31-.29.49-.15.18-.31.39-.45.52-.15.15-.31.31-.13.6.18.29.77 1.27 1.66 2.06 1.13 1 2.09 1.32 2.37 1.47.29.15.46.13.63-.07.18-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2.01.96.29.15.49.22.56.34.07.12.07.71-.17 1.39z"/>
          </svg>
          Abrir WhatsApp · {whatsappDisplay()}
        </a>
        <p class="ct-form__alt">
          Si lo prefieres, escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ct-hero {
    padding-block: var(--space-16) var(--space-8);
    text-align: center;
  }
  .ct-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1;
    margin-top: var(--space-3);
    font-style: italic;
    color: var(--ink);
  }
  .ct-hero__wave { width: 120px; height: 12px; margin: var(--space-4) auto; }
  .ct-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink-mute);
    max-width: 36rem;
    margin-inline: auto;
  }

  .ct-grid { background: var(--bg-soft); }
  .ct-grid__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 900px) { .ct-grid__inner { grid-template-columns: 0.9fr 1.2fr; gap: var(--space-16); } }

  .ct-aside { position: relative; }
  .ct-aside__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: var(--space-6);
  }
  .ct-info { margin-bottom: var(--space-6); }
  .ct-info__label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: var(--space-1);
  }
  .ct-info__value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
    display: block;
  }
  .ct-info__value:hover { color: var(--terracotta); }
  .ct-info__hint {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-mute);
    margin-top: 4px;
    font-style: italic;
  }
  .ct-social { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .ct-social a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink-soft);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--bg-deep);
  }
  .ct-social a:hover { color: var(--terracotta); border-color: var(--terracotta); }

  .ct-form {
    background: var(--bg);
    border-radius: var(--r-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .ct-form__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }
  .ct-form__lede {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
    max-width: 36rem;
  }
  .ct-form__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.5rem;
    font-size: 0.95rem;
  }
  .ct-form__alt {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--ink-mute);
    margin-top: var(--space-4);
  }
  .ct-form__alt a {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--bg-deep);
  }
  .ct-form__alt a:hover {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }
</style>

<script>
  // El formulario de contacto se ha sustituido por un CTA directo a WhatsApp.
  // No hay lógica de cliente: el enlace `wa.me` abre el chat con un mensaje pre-rellenado.
</script>
