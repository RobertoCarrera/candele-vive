---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import Wave from '../components/decorative/Wave.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';

const allProducts = (await getCollection('products'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const collections = (await getCollection('collections'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const SHIFTS = ['none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none'];

const title = 'Catálogo · velas hechas a mano';
const description = 'Todas las velas Candele Vive en un solo lugar. Filtra por colección, encuentra tu próxima favorita.';
---

<BaseLayout title={title} description={description}>
  <header class="cat-hero">
    <div class="container">
      <p class="eyebrow cat-hero__eyebrow">el libro completo</p>
      <h1 class="cat-hero__title">El <em>catálogo</em></h1>
      <Wave class="cat-hero__wave" color="var(--terracotta)" />
      <p class="cat-hero__lede">
        Diecinueve velas, cinco colecciones. Hojea el libro, filtra por estación,
        o mira el catálogo entero.
      </p>
    </div>
  </header>

  <nav class="cat-filters" aria-label="Filtros por colección" data-cat-filters>
    <div class="container cat-filters__inner">
      <span class="cat-filters__label">Filtrar por</span>
      <div class="cat-filters__pills">
        <button class="cat-filter is-active" data-filter="all">Todas</button>
        {collections.map((c) => (
          <button class="cat-filter" data-filter={c.data.slug}>
            {c.data.name} <em>· {c.data.season}</em>
          </button>
        ))}
      </div>
    </div>
  </nav>

  <section class="cat-grid-section">
    <div class="container-wide">
      <ul class="cat-grid" data-cat-grid>
        {allProducts.map((p, i) => (
          <li data-collection={p.data.collection}>
            <ProductCard
              id={p.data.id}
              name={p.data.name}
              price={p.data.price}
              category={p.data.category}
              collection={p.data.collection}
              image={p.data.image}
              imageAlt={p.data.imageAlt}
              burnTime={p.data.burnTime}
              size={p.data.size}
              badge={p.data.badge}
              shortDescription={p.data.shortDescription}
              order={p.data.order}
              shift={SHIFTS[i] as 'up' | 'down' | 'none'}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-hero {
    padding-block: var(--space-16) var(--space-12);
    text-align: center;
  }
  .cat-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin-top: var(--space-3);
  }
  .cat-hero__title em { font-style: italic; color: var(--terracotta); }
  .cat-hero__wave { width: 140px; height: 12px; margin: var(--space-4) auto; }
  .cat-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-mute);
    max-width: 36rem;
    margin-inline: auto;
    line-height: 1.6;
  }

  .cat-filters {
    position: sticky;
    top: 70px;
    z-index: 5;
    background: rgba(244, 238, 224, 0.92);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--bg-deep);
    margin-bottom: var(--space-12);
  }
  .cat-filters__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  @media (min-width: 700px) {
    .cat-filters__inner {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-4);
    }
  }
  .cat-filters__label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .cat-filters__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }
  .cat-filter {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    padding: 0.5rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.3s var(--ease-soft);
    white-space: nowrap;
  }
  .cat-filter em { color: var(--ink-mute); font-style: normal; }
  .cat-filter:hover { background: var(--bg-soft); color: var(--ink); border-color: var(--bg-deep); }
  .cat-filter.is-active {
    background: var(--ink);
    color: var(--bg-soft);
    border-color: var(--ink);
  }
  .cat-filter.is-active em { color: var(--bg-soft); opacity: 0.6; }

  .cat-grid-section { padding-bottom: var(--space-24); }
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-6);
  }
  @media (min-width: 640px)  { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
  .cat-grid li.is-hidden { display: none; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-cat-grid] > li');

  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      const f = b.dataset.filter;
      items.forEach((li) => {
        const matches = f === 'all' || li.dataset.collection === f;
        li.classList.toggle('is-hidden', !matches);
      });
    });
  });
</script>
