---
/**
 * Testimonials — citas en formato conversacional, con un avatar inicial.
 * Sin comillas gigantes, sin marco.
 */
import { UI } from '../../data/ui';

const reviews = [
  {
    initial: 'L',
    name: 'Lucía M.',
    city: 'Madrid',
    quote: 'La vela de Intuizione huele a un jardín que no sabía que me gustaba. Ahora enciendo una cada domingo.',
    product: 'Intuizione',
  },
  {
    initial: 'M',
    name: 'Marta R.',
    city: 'Barcelona',
    quote: 'Pedí tres velas de la colección Radice para mi salón. Lo mejor: el packaging, hecho con mimo, sin plásticos. Y el aroma, increíble.',
    product: 'Focolare',
  },
  {
    initial: 'C',
    name: 'Carmen P.',
    city: 'Vilanova i la Geltrú',
    quote: 'Vivo a tres calles del taller y nunca había entrado. Ahora voy cada dos meses. Las chicas se acuerdan de mi nombre. Eso no se compra.',
    product: 'Risveglio',
  },
];
---

<section class="testimonials section" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="testimonials__head">
      <p class="eyebrow">{UI.home.testimonialsTagline}</p>
      <h2 id="testimonials-title" class="testimonials__title">
        Lo que <em>nos cuentan</em>
      </h2>
    </header>

    <ul class="testimonials__grid">
      {reviews.map((r) => (
        <li class="testimonials__item">
          <article class="testimonials__card">
            <p class="testimonials__quote">{r.quote}</p>
            <footer class="testimonials__author">
              <span class="testimonials__avatar" aria-hidden="true">{r.initial}</span>
              <div>
                <p class="testimonials__name">— {r.name}</p>
                <p class="testimonials__meta">{r.city} · sobre {r.product}</p>
              </div>
            </footer>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonials { background: var(--bg); }
  .testimonials__head { text-align: center; margin-bottom: var(--space-12); }
  .testimonials__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    margin-top: var(--space-3);
  }
  .testimonials__title em { font-style: italic; color: var(--terracotta); }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 64rem;
    margin-inline: auto;
  }
  @media (min-width: 800px) { .testimonials__grid { grid-template-columns: repeat(3, 1fr); } }

  .testimonials__card {
    background: var(--bg-soft);
    border-radius: var(--r-lg);
    padding: var(--space-6);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .testimonials__quote {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
    flex: 1;
  }
  .testimonials__quote::before {
    content: '“';
    color: var(--terracotta);
    font-size: 1.4em;
    line-height: 0;
    margin-right: 0.1em;
    vertical-align: -0.2em;
  }
  .testimonials__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--bg-deep);
  }
  .testimonials__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--bg-soft);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
  }
  .testimonials__name {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
  }
  .testimonials__meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-mute);
    margin-top: 2px;
  }
</style>
