---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/decorative/Wave.astro';
import { SITE, whatsappLink, whatsappDisplay } from '../data/site';
import { UI } from '../data/ui';

const subjects = UI.contact.subjects;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE.url}/contacto#business`,
    name: SITE.legalName,
    image: `${SITE.url}/og-image.svg`,
    url: SITE.url,
    telephone: SITE.phone,
    email: SITE.email,
    priceRange: '€€',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 41.2244,
      longitude: 1.7256,
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '10:00',
        closes: '18:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '11:00',
        closes: '14:00',
      },
    ],
    sameAs: [SITE.social.instagram, SITE.social.facebook, SITE.social.pinterest].filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: SITE.url + '/contacto' },
    ],
  },
];
---

<BaseLayout title={UI.contact.title} description={UI.contact.intro} jsonLd={jsonLd}>
  <header class="ct-hero">
    <div class="container">
      <p class="eyebrow">{UI.contact.tagline}</p>
      <h1 class="ct-hero__title">{UI.contact.headline}</h1>
      <Wave class="ct-hero__wave" color="var(--terracotta)" />
      <p class="ct-hero__lede">{UI.contact.intro}</p>
    </div>
  </header>

  <section class="ct-grid section">
    <div class="container-wide ct-grid__inner">
      <aside class="ct-aside">
        <h2 class="ct-aside__title">Cómo encontrarnos</h2>

        <div class="ct-info">
          <p class="ct-info__label">Email</p>
          <a href={`mailto:${SITE.email}`} class="ct-info__value">{SITE.email}</a>
          <p class="ct-info__hint">{UI.contact.hoursEmail}</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">WhatsApp</p>
          <a href={whatsappLink('Hola, me gustaría información sobre una vela Candele Vive')} class="ct-info__value" target="_blank" rel="noopener noreferrer">{whatsappDisplay()}</a>
          <p class="ct-info__hint">{UI.contact.hoursPhone}</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">Estudio</p>
          <p class="ct-info__value">{SITE.address.locality}</p>
          <p class="ct-info__hint">{SITE.address.region}, {SITE.address.postalCode} — cita previa</p>
        </div>

        <div class="ct-info">
          <p class="ct-info__label">Síguenos</p>
          <ul class="ct-social">
            <li><a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
            <li><a href={SITE.social.pinterest} target="_blank" rel="noopener noreferrer">Pinterest</a></li>
          </ul>
        </div>
      </aside>

      <form class="ct-form" data-contact-form>
        <h2 class="ct-form__title">{UI.contact.formTitle}</h2>

        <div class="ct-form__row">
          <label class="ct-field">
            <span>{UI.contact.fields.name}</span>
            <input type="text" name="name" required placeholder={UI.contact.placeholders.name} autocomplete="name" />
          </label>
          <label class="ct-field">
            <span>{UI.contact.fields.email}</span>
            <input type="email" name="email" required placeholder={UI.contact.placeholders.email} autocomplete="email" />
          </label>
        </div>

        <label class="ct-field">
          <span>{UI.contact.fields.subject}</span>
          <select name="subject" required>
            {subjects.map((s, i) => <option value={s} selected={i === 0}>{s}</option>)}
          </select>
        </label>

        <label class="ct-field">
          <span>{UI.contact.fields.message}</span>
          <textarea name="message" required placeholder={UI.contact.placeholders.message} rows="6"></textarea>
        </label>

        <div class="ct-form__cta">
          <button type="submit" class="btn btn-primary">{UI.buttons.sendMessage}</button>
          <p class="ct-form__status" data-contact-status hidden>{UI.contact.success}</p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .ct-hero {
    padding-block: var(--space-16) var(--space-8);
    text-align: center;
  }
  .ct-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1;
    margin-top: var(--space-3);
    font-style: italic;
    color: var(--ink);
  }
  .ct-hero__wave { width: 120px; height: 12px; margin: var(--space-4) auto; }
  .ct-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink-mute);
    max-width: 36rem;
    margin-inline: auto;
  }

  .ct-grid { background: var(--bg-soft); }
  .ct-grid__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
  @media (min-width: 900px) { .ct-grid__inner { grid-template-columns: 0.9fr 1.2fr; gap: var(--space-16); } }

  .ct-aside { position: relative; }
  .ct-aside__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: var(--space-6);
  }
  .ct-info { margin-bottom: var(--space-6); }
  .ct-info__label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: var(--space-1);
  }
  .ct-info__value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
    display: block;
  }
  .ct-info__value:hover { color: var(--terracotta); }
  .ct-info__hint {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-mute);
    margin-top: 4px;
    font-style: italic;
  }
  .ct-social { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .ct-social a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink-soft);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--bg-deep);
  }
  .ct-social a:hover { color: var(--terracotta); border-color: var(--terracotta); }

  .ct-form {
    background: var(--bg);
    border-radius: var(--r-lg);
    padding: var(--space-8);
  }
  .ct-form__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    margin-bottom: var(--space-6);
  }
  .ct-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 600px) { .ct-form__row { grid-template-columns: 1fr 1fr; } }
  .ct-field { display: block; margin-bottom: var(--space-4); }
  .ct-form__cta { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-4); }
  .ct-form__status {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--sage);
    font-size: 0.95rem;
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-contact-status]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!status) return;
    status.hidden = false;
    (form as HTMLFormElement).reset();
  });
</script>
