---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import Wave from '../components/decorative/Wave.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { MOODS, MOOD_LABEL, moodsFor } from '../lib/moods';

const allProducts = (await getCollection('products'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const collections = (await getCollection('collections'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const SHIFTS = ['none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none', 'down', 'up', 'none'];

const title = 'Catálogo · velas hechas a mano';
const description = 'Todas las velas Candele Vive en un solo lugar. Filtra por colección o por intención, encuentra tu próxima favorita.';

const catalogFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Cuántas velas tiene el catálogo?', acceptedAnswer: { '@type': 'Answer', text: '19 velas divididas en 5 colecciones: Ánima (5), Radice (4), Luce (6), Solea (4) y Especiales (3).' } },
    { '@type': 'Question', name: '¿Cómo filtro las velas por estado de ánimo?', acceptedAnswer: { '@type': 'Answer', text: 'En la barra de filtros del catálogo puedes elegir la colección (Ánima, Radice, Luce, Solea, Especiales) y la intención (Relax, Energía, Hogar, Conexión, Naturaleza). Los filtros se combinan.' } },
    { '@type': 'Question', name: '¿Qué incluye la Colección Especiales?', acceptedAnswer: { '@type': 'Answer', text: 'La Colección Especiales reúne velas rituales de cera de abeja (Colección Miele), una vela de masaje con aceite de argán (Carezza) y un kit DIY para crear tu propia vela (Rituale).' } },
    { '@type': 'Question', name: '¿Puedo comprar al por mayor?', acceptedAnswer: { '@type': 'Answer', text: 'Sí, trabajamos con tiendas de diseño y concept stores. Escríbenos a hola@candelevive.es con el asunto "Mayoristas" y te pasamos dossier y lista de precios.' } },
  ],
};

const catalogBreadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: SITE.url + '/catalogo' },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={[catalogBreadcrumbJsonLd, catalogFaqJsonLd]}>
  <header class="cat-hero">
    <div class="container">
      <p class="eyebrow cat-hero__eyebrow">el libro completo</p>
      <h1 class="cat-hero__title">El <em>catálogo</em></h1>
      <Wave class="cat-hero__wave" color="var(--terracotta)" />
      <p class="cat-hero__lede">
        Diecinueve velas, cinco colecciones. Hojea el libro, filtra por estación
        o por intención, y mira el catálogo entero.
      </p>
    </div>
  </header>

  <div class="cat-filters" data-cat-filters>
    {/* Filtros por colección */}
    <div class="cat-filters__row" data-filter-group="collection">
      <div class="container cat-filters__inner">
        <span class="cat-filters__label">Colección</span>
        <div class="cat-filters__pills" role="tablist">
          <button class="cat-filter is-active" data-filter-collection="all">Todas</button>
          {collections.map((c) => (
            <button class="cat-filter" data-filter-collection={c.data.slug}>
              {c.data.name} <em>· {c.data.season}</em>
            </button>
          ))}
        </div>
      </div>
    </div>
    {/* Filtros por intención / emoción */}
    <div class="cat-filters__row" data-filter-group="mood">
      <div class="container cat-filters__inner">
        <span class="cat-filters__label">Intención</span>
        <div class="cat-filters__pills" role="tablist">
          <button class="cat-filter is-active" data-filter-mood="all">Cualquiera</button>
          {MOODS.map((m) => (
            <button class="cat-filter" data-filter-mood={m}>{MOOD_LABEL[m]}</button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <p class="cat-empty" data-cat-empty hidden>
    No hay velas que coincidan con los filtros. <button type="button" data-cat-reset>Quitar filtros</button>
  </p>

  <section class="cat-grid-section">
    <div class="container-wide">
      <ul class="cat-grid" data-cat-grid>
        {allProducts.map((p, i) => (
          <li
            data-collection={p.data.collection}
            data-moods={moodsFor(p.data.id).join(',')}
          >
            <ProductCard
              id={p.data.id}
              name={p.data.name}
              price={p.data.price}
              category={p.data.category}
              collection={p.data.collection}
              image={p.data.image}
              imageAlt={p.data.imageAlt}
              burnTime={p.data.burnTime}
              size={p.data.size}
              badge={p.data.badge}
              shortDescription={p.data.shortDescription}
              order={p.data.order}
              shift={SHIFTS[i] as 'up' | 'down' | 'none'}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cat-faq section">
    <div class="container cat-faq__inner">
      <header class="cat-faq__head">
        <p class="eyebrow">preguntas frecuentes</p>
        <h2 class="cat-faq__title">Sobre el catálogo</h2>
      </header>
      <ul class="cat-faq__list" data-faq>
        <li>
          <details class="cat-faq__item">
            <summary><span>¿Cuántas velas tiene el catálogo?</span><span class="cat-faq__chev" aria-hidden="true">↓</span></summary>
            <div><p>19 velas divididas en 5 colecciones: Ánima (5), Radice (4), Luce (6), Solea (4) y Especiales (3).</p></div>
          </details>
        </li>
        <li>
          <details class="cat-faq__item">
            <summary><span>¿Cómo filtro por estado de ánimo?</span><span class="cat-faq__chev" aria-hidden="true">↓</span></summary>
            <div><p>En la barra de filtros elige colección y la intención (Relax, Energía, Hogar, Conexión, Naturaleza). Los filtros se combinan: por ejemplo, "Luce + Relax" te muestra las velas de la colección Luce pensadas para descansar.</p></div>
          </details>
        </li>
        <li>
          <details class="cat-faq__item">
            <summary><span>¿Qué incluye la Colección Especiales?</span><span class="cat-faq__chev" aria-hidden="true">↓</span></summary>
            <div><p>Velas rituales de cera de abeja (Colección Miele), vela de masaje con aceite de argán (Carezza) y kit DIY para crear tu propia vela (Rituale). Productos sin temporada fija.</p></div>
          </details>
        </li>
        <li>
          <details class="cat-faq__item">
            <summary><span>¿Puedo comprar al por mayor?</span><span class="cat-faq__chev" aria-hidden="true">↓</span></summary>
            <div><p>Sí, trabajamos con tiendas de diseño y concept stores. Escríbenos a hola@candelevive.es con el asunto "Mayoristas".</p></div>
          </details>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-hero {
    padding-block: var(--space-16) var(--space-12);
    text-align: center;
  }
  .cat-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin-top: var(--space-3);
  }
  .cat-hero__title em { font-style: italic; color: var(--terracotta); }
  .cat-hero__wave { width: 140px; height: 12px; margin: var(--space-4) auto; }
  .cat-hero__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-mute);
    max-width: 36rem;
    margin-inline: auto;
    line-height: 1.6;
  }

  .cat-filters {
    position: sticky;
    top: 70px;
    z-index: 5;
    background: rgba(244, 238, 224, 0.92);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--bg-deep);
    margin-bottom: var(--space-12);
  }
  .cat-filters__row + .cat-filters__row {
    border-top: 1px solid var(--bg-deep);
  }
  .cat-filters__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  @media (min-width: 700px) {
    .cat-filters__inner {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-4);
    }
  }
  .cat-filters__label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    min-width: 80px;
    text-align: right;
  }
  .cat-filters__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }
  .cat-filter {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    padding: 0.5rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.3s var(--ease-soft);
    white-space: nowrap;
  }
  .cat-filter em { color: var(--ink-mute); font-style: normal; }
  .cat-filter:hover { background: var(--bg-soft); color: var(--ink); border-color: var(--bg-deep); }
  .cat-filter.is-active {
    background: var(--ink);
    color: var(--bg-soft);
    border-color: var(--ink);
  }
  .cat-filter.is-active em { color: var(--bg-soft); opacity: 0.6; }

  .cat-empty {
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 1.1rem;
    padding: var(--space-12) var(--space-6);
    max-width: 32rem;
    margin-inline: auto;
  }
  .cat-empty button {
    background: transparent;
    border: 0;
    color: var(--terracotta);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    margin-left: 0.4rem;
  }

  .cat-grid-section { padding-bottom: var(--space-24); }
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12) var(--space-6);
  }
  @media (min-width: 640px)  { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
  .cat-grid li.is-hidden { display: none; }

  /* === FAQ del catálogo === */
  .cat-faq { background: var(--bg-soft); }
  .cat-faq__inner { max-width: 44rem; }
  .cat-faq__head { text-align: center; margin-bottom: var(--space-8); }
  .cat-faq__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--ink);
    margin-top: var(--space-3);
  }
  .cat-faq__list { display: flex; flex-direction: column; }
  .cat-faq__item {
    border-top: 1px solid var(--bg-deep);
    padding-block: var(--space-5);
  }
  .cat-faq__item:last-child { border-bottom: 1px solid var(--bg-deep); }
  .cat-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
    list-style: none;
  }
  .cat-faq__item summary::-webkit-details-marker { display: none; }
  .cat-faq__item summary:hover { color: var(--terracotta); }
  .cat-faq__chev {
    flex-shrink: 0;
    color: var(--terracotta);
    transition: transform 0.3s var(--ease-soft);
  }
  .cat-faq__item[open] .cat-faq__chev { transform: rotate(180deg); }
  .cat-faq__item div {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>

<script>
  // Filtros: combinación de colección + intención (AND). "all" = no filtra.
  const items = document.querySelectorAll<HTMLElement>('[data-cat-grid] > li');
  const collButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-collection]');
  const moodButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-mood]');
  const emptyState = document.querySelector<HTMLElement>('[data-cat-empty]');
  const resetBtn   = document.querySelector<HTMLButtonElement>('[data-cat-reset]');

  const state = { collection: 'all', mood: 'all' };

  const apply = () => {
    let visible = 0;
    items.forEach((li) => {
      const coll = li.dataset.collection || '';
      const moods = (li.dataset.moods || '').split(',').filter(Boolean);
      const matchColl = state.collection === 'all' || coll === state.collection;
      const matchMood = state.mood === 'all' || moods.includes(state.mood);
      const show = matchColl && matchMood;
      li.classList.toggle('is-hidden', !show);
      if (show) visible++;
    });
    if (emptyState) emptyState.hidden = visible > 0;
  };

  const wire = (btns: NodeListOf<HTMLButtonElement>, key: 'collection' | 'mood', attr: string) => {
    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.remove('is-active'));
        b.classList.add('is-active');
        state[key] = b.getAttribute(attr) || 'all';
        apply();
      });
    });
  };
  wire(collButtons, 'collection', 'data-filter-collection');
  wire(moodButtons, 'mood',       'data-filter-mood');

  resetBtn?.addEventListener('click', () => {
    state.collection = 'all';
    state.mood = 'all';
    collButtons.forEach((b) => b.classList.toggle('is-active', (b.getAttribute('data-filter-collection') || 'all') === 'all'));
    moodButtons.forEach((b) => b.classList.toggle('is-active', (b.getAttribute('data-filter-mood') || 'all') === 'all'));
    apply();
  });
</script>
