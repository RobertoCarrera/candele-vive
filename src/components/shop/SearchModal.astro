---
/**
 * SearchModal — búsqueda client-side de productos.
 * Se abre al pulsar el icono 🔍 de la navbar. Búsqueda por nombre, categoría
 * y nombre de la colección. Resultados en vivo conforme escribes.
 *
 * Los productos se inyectan como JSON vía `define:vars` (no hay fetch, no
 * hay backend, todo está en el bundle). El dataset es pequeño (19 velas).
 */
import { getCollection } from 'astro:content';

interface SearchProduct {
  id: number;
  name: string;
  category: string;
  collection: string;
  collectionName: string;
  price: number;
  image: string;
  imageAlt: string;
}

const allProducts = (await getCollection('products'));
const allCollections = (await getCollection('collections'));
const collNameBySlug = Object.fromEntries(allCollections.map((c) => [c.data.slug, c.data.name]));

const searchData: SearchProduct[] = allProducts
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((p) => ({
    id: p.data.id,
    name: p.data.name,
    category: p.data.category,
    collection: p.data.collection,
    collectionName: collNameBySlug[p.data.collection] ?? p.data.category,
    price: p.data.price,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
  }));
---

<div class="search-modal" data-search-modal hidden aria-hidden="true" role="dialog" aria-label="Buscar productos">
  <div class="search-modal__backdrop" data-search-close></div>
  <div class="search-modal__panel" role="document">
    <div class="search-modal__field">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="20" y1="20" x2="16.5" y2="16.5" />
      </svg>
      <input
        type="search"
        class="search-modal__input"
        placeholder="Busca por nombre, colección, aroma…"
        data-search-input
        autocomplete="off"
        aria-label="Buscar productos"
      />
      <button type="button" class="search-modal__close" data-search-close aria-label="Cerrar">×</button>
    </div>
    <div class="search-modal__results" data-search-results aria-live="polite">
      <p class="search-modal__hint">Empieza a escribir para ver resultados.</p>
    </div>
  </div>
</div>

<style is:global>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5vh var(--space-6);
  }
  .search-modal[hidden] { display: none; }
  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(45, 33, 27, 0.55);
    backdrop-filter: blur(4px);
  }
  .search-modal__panel {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--bg);
    border-radius: var(--r-lg);
    box-shadow: 0 20px 50px -16px rgba(45, 33, 27, 0.3);
    overflow: hidden;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    animation: search-pop 0.3s var(--ease);
  }
  @keyframes search-pop {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .search-modal__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--bg-deep);
    color: var(--ink-mute);
  }
  .search-modal__input {
    flex: 1;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    padding: 0;
  }
  .search-modal__input:focus { outline: none; }
  .search-modal__input::placeholder {
    color: var(--ink-mute);
    font-style: italic;
  }
  .search-modal__close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: var(--bg-soft);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft);
  }
  .search-modal__close:hover { background: var(--terracotta); color: var(--bg-soft); }
  .search-modal__results {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-3) var(--space-3) var(--space-6);
  }
  .search-modal__hint {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-mute);
    text-align: center;
    padding: var(--space-8) var(--space-4);
  }
  .search-modal__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .search-modal__item {}
  .search-modal__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.2s var(--ease-soft);
  }
  .search-modal__link:hover,
  .search-modal__link.is-focused {
    background: var(--bg-soft);
  }
  .search-modal__thumb {
    width: 56px;
    height: 56px;
    border-radius: var(--r-sm);
    object-fit: cover;
    background: var(--bg-warm);
    flex-shrink: 0;
  }
  .search-modal__info { flex: 1; min-width: 0; }
  .search-modal__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
  }
  .search-modal__cat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 2px;
  }
  .search-modal__price {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--terracotta);
    font-weight: 500;
    flex-shrink: 0;
  }
  .search-modal__empty {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-mute);
    text-align: center;
    padding: var(--space-8) var(--space-4);
  }
  .search-modal__empty strong { color: var(--ink); font-style: normal; font-weight: 500; }
</style>

<script
  define:vars={{ products: searchData }}
>
  const modal  = document.querySelector('[data-search-modal]');
  const input  = modal?.querySelector('[data-search-input]');
  const resBox = modal?.querySelector('[data-search-results]');
  const opens  = document.querySelectorAll('[data-search-open]');
  const closes = document.querySelectorAll('[data-search-close]');
  if (!modal || !input || !resBox) {} else {
    const fmtPrice = (n) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(n);
    const norm = (s) => (s || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const score = (p, q) => {
      const n = norm(p.name), c = norm(p.category), cn = norm(p.collectionName);
      if (n.startsWith(q)) return 3;
      if (n.includes(q)) return 2;
      if (c.includes(q)) return 1;
      if (cn.includes(q)) return 1;
      return 0;
    };
    const render = (results) => {
      if (!results.length) {
        resBox.innerHTML = '<p class="search-modal__empty">No encontramos velas para <strong></strong>. Prueba con otro aroma o colección.</p>'.replace('<strong></strong>', `<strong>${input.value}</strong>`);
        return;
      }
      resBox.innerHTML = `<ul class="search-modal__list">${results.map((p) => `
        <li class="search-modal__item">
          <a href="/producto/${p.id}" class="search-modal__link" data-search-link>
            <img class="search-modal__thumb" src="${p.image}" alt="${p.imageAlt}" loading="lazy" />
            <div class="search-modal__info">
              <div class="search-modal__name">${p.name}</div>
              <div class="search-modal__cat">${p.collectionName}</div>
            </div>
            <div class="search-modal__price">${fmtPrice(p.price)}</div>
          </a>
        </li>`).join('')}</ul>`;
    };
    const search = (raw) => {
      const q = norm(raw.trim());
      if (!q) { resBox.innerHTML = '<p class="search-modal__hint">Empieza a escribir para ver resultados.</p>'; return; }
      const results = products
        .map((p) => ({ p, s: score(p, q) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 8)
        .map((r) => r.p);
      render(results);
    };
    input.addEventListener('input', () => search(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); }
    });

    const open = () => {
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 50);
    };
    const close = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.value = '';
      search('');
    };
    opens.forEach((b) => b.addEventListener('click', open));
    closes.forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
    // Atajo de teclado: "/" o Cmd/Ctrl+K para abrir
    document.addEventListener('keydown', (e) => {
      if (modal.hidden && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'))) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
